			};

			hsi2c10_bus: hsi2c10-bus-pins {
				samsung,pins = "gpp20-0", "gpp20-1";
				samsung,pin-function = <ZUMAPRO_PIN_FUNC_2>;
				samsung,pin-pud = <ZUMAPRO_PIN_PULL_NONE>;
				samsung,pin-drv = <ZUMAPRO_PIN_DRV_X1>;
			};
		};

		pinctrl_hsi0: pinctrl@12040000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x12040000 0x1000>;
			interrupts = <GIC_SPI 413 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";

			gph0: gph0-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
