				<0x09 0x1104011b 0x101 0x69 0x7f>,
				<0x0a 0x1205010b 0x101 0x2d 0x7f>,
				<0x0b 0x1205010b 0x101 0x6d 0x7f>,
				<0x0c 0x906014a 0x101 0x30 0x7f>,
				<0x0d 0x906014a 0x101 0x70 0x7f>,
				<0x0e 0x1307011b 0x101 0x31 0x7f>,
				<0x0f 0x1307011b 0x101 0x71 0x7f>,
				<0x10 0x1a08011a 0x101 0x2b 0x7f>,
				<0x11 0x1a08011a 0x101 0x6b 0x7f>,
				<0x12 0xa09011b 0x101 0x01 0x7f>,
				<0x13 0xa09011b 0x101 0x41 0x7f>,
				<0x14 0xb0a011b 0x101 0x09 0x7f>,
				<0x15 0xb0a011b 0x101 0x49 0x7f>,
				<0x16 0xc0b011b 0x101 0x0d 0x7f>,
				<0x17 0xc0b011b 0x101 0x4d 0x7f>,
