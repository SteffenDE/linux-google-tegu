				#interrupt-cells = <2>;
			};
		};

		pinctrl_hsi1: pinctrl@13040000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x13040000 0x1000>;
			clocks = <&cmu_hsi2 CLK_GOUT_HSI2_GPIO_HSI2_PCLK>;
			clock-names = "pclk";
			interrupts = <GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";

			gph3: gph3-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gph4: gph4-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};
		};

		pinctrl_hsi2: pinctrl@13060000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x13060000 0x1000>;
			clocks = <&cmu_hsi2 CLK_GOUT_HSI2_GPIO_HSI2UFS_PCLK>;
			clock-names = "pclk";
			interrupts = <GIC_SPI 433 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "okay";

			gph5: gph5-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			ufs_rst_n: ufs-rst-n-pins {
				samsung,pins = "gph5-1";
				samsung,pin-function = <ZUMAPRO_PIN_FUNC_2>;
				samsung,pin-pud = <ZUMAPRO_PIN_PULL_NONE>;
				samsung,pin-con-pdn = <ZUMAPRO_PIN_CON_PDN_OUTPUT_HIGH>;
				samsung,pin-pud-pdn = <ZUMAPRO_PIN_PULL_NONE>;
