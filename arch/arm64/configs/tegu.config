# SPDX-License-Identifier: GPL-2.0
#
# Pixel 9a (tegu / zumapro) bring-up fragment.
# Merge this on top of arm64 defconfig for fastboot-boot test images.

# Early bring-up console and initramfs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y

# Bootloader framebuffer experiment.
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_MMIO_INIT_HELPER=y

# Display bring-up groundwork. Keep these built in for early panel/DSI tests.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_BRIDGE_CONNECTOR=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS_ZUMAPRO_DPU=y
CONFIG_DRM_EXYNOS_DSI=y
CONFIG_DRM_PANEL_GOOGLE_TG4C=y
CONFIG_PHY_ZUMAPRO_MIPI_DPHY=y
CONFIG_PHY_ZUMAPRO_PCIE=y
CONFIG_PCIE_ZUMAPRO=y
CONFIG_SAMSUNG_SYSMMU_GROUP=y
CONFIG_SAMSUNG_SYSMMU_V9=y

# Samsung/Exynos platform plumbing used by the tegu DT.
CONFIG_ARCH_EXYNOS=y
CONFIG_COMMON_CLK_SAMSUNG=y
CONFIG_PINCTRL_SAMSUNG=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# UFS is the boot storage path, so keep it built in.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_PHY_SAMSUNG_UFS=y

# USB bring-up. The PHY providers must be built in for the initramfs boot path;
# otherwise DWC3 probes before modules are available and stays deferred.
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_TYPEC=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_PHY_SNPS_EUSB2=y

# ACPM IPC + S2MPG14 PMIC (touchscreen rails). Built in: the touch driver
# probes from the initramfs and needs the regulators to resolve.
CONFIG_MAILBOX=y
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_ACPM_PROTOCOL=y
CONFIG_MFD_SEC_ACPM=y
CONFIG_REGULATOR_S2MPS11=y
# On-device power metering (ODPM) on the S2MPG14 main PMIC, read-only.
CONFIG_IIO=y
CONFIG_S2MPG1X_METER=y

# ACPM TMU thermal sensors (CPU clusters/GPU/ISP/TPU/AUR), read-only over IPC.
CONFIG_ZUMAPRO_ACPM_TMU=y
# CPU thermal throttling: the firmware only measures on a bare boot, so Linux
# owns it via cpufreq cooling.  The CPU-cluster zones use the power_allocator
# (IPA) PID governor, which holds the setpoint; step_wise only limit-cycles on
# the fast X4.  IPA needs an Energy Model (so the cpufreq cooling devices are
# power actors) -- cpufreq-dt builds one from the estimated CPU opp-microvolt.
# All were already on via defconfig; pinned as drift guard-rails.
CONFIG_CPU_THERMAL=y
CONFIG_ENERGY_MODEL=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR=y
# step_wise kept available as a fallback governor (selectable via sysfs policy).
CONFIG_THERMAL_GOV_STEP_WISE=y

# GPU (Mali-G715 / panthor). Built in for bring-up: the ACPM clock provider
# must be present when the GPU node probes (panthor's "core"/"stacks" clocks
# come from it), and panthor itself, so neither silently fails to bind when
# the rootfs modules are out of date during a fastboot-boot test image.
CONFIG_EXYNOS_ACPM_CLK=y
CONFIG_DRM_PANTHOR=y

# CPU DVFS guard-rails. cpufreq-dt drives the per-cluster ACPM DVFS clocks once
# the CPU nodes carry operating-points-v2, binding through the cpufreq-dt-platdev
# cpu0 fallback (zumapro is not in the platdev blocklist). All of these are
# already on in the arm64 defconfig / Kconfig defaults -- CPUFREQ_DT selects
# CPUFREQ_DT_PLATDEV, and the default-governor choice is schedutil on arm64 --
# but pin them so a defconfig change cannot silently drop DVFS or fall back to
# the performance governor (which would peg every cluster at its top OPP).
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Activity Monitors (default-y; pinned). Once AMU validates, the hardware-measured
# average frequency is exposed over serial via the cpufreq cpuinfo_avg_freq sysfs
# node. (scaling_cur_freq's AMU path is x86-only -- CONFIG_CPUFREQ_ARCH_CUR_FREQ --
# so on arm64 scaling_cur_freq stays the ACPM-requested setpoint.)
CONFIG_ARM64_AMU_EXTN=y

# Touchscreen: Synaptics TouchComm on the HSI0 USI2 SPI bus.
CONFIG_SPI=y
CONFIG_SPI_S3C64XX=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SYNA_TCM=y

# Hardware buttons (power, volume up/down) via gpio-keys on the alive GPIO
# banks. INPUT_EVDEV is what surfaces the key events to userspace so the UI can
# wake the display and navigate. Both are in the arm64 defconfig, but pin them
# here so the feature does not silently regress on a defconfig change.
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y

# Battery state-of-charge: MAX77779 fuel gauge on the PMIC I2C bus (USI6).
# Read-only SoC/voltage/temperature reporting; surfaces a battery indicator to
# UPower. POWER_SUPPLY is in the arm64 defconfig but pin it so the gauge cannot
# silently lose its class dependency on a defconfig change.
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_MAX77779=y

# WiFi: Broadcom BCM4383 FullMAC over the GEN3A_1 PCIe root complex (HSI2).
# brcmfmac binds to the PCIe endpoint by ID; built in so it probes on the
# fastboot-boot initramfs path, where the firmware is staged under
# /lib/firmware/brcm/ as brcmfmac4383-pcie.{bin,txt,clm_blob} (the vendor
# fw/NVRAM/CLM blobs renamed to brcmfmac's convention). FullMAC -> cfg80211
# only, no mac80211. RFKILL must be built in too: cfg80211's
# "depends on RFKILL || !RFKILL" otherwise caps it (and brcmfmac) at =m.
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y

# Exynos Modem 5300 boot transport (mobile data bring-up).  Built in so
# /dev/umts_boot0 is up without module plumbing; userspace (cbd-lite) streams
# the firmware over it.  GNSS must be built in (or off): "depends on GNSS ||
# GNSS = n" caps WWAN at =m otherwise.
CONFIG_GNSS=y
CONFIG_WWAN=y
CONFIG_S5300_MODEM=y

# f2fs so the bring-up initramfs can mount the Android vendor partitions
# (efs, modem_userdata) read-only where cbd-lite sources the per-device modem
# NV and anti-rollback replay.  Built in: the initramfs loads no modules.
CONFIG_F2FS_FS=y

# Keep gadget/configfs available from the initramfs shell for USB testing.
CONFIG_CONFIGFS_FS=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Trusty TEE (AoC firmware-start dependency; see research/aoc.md)
CONFIG_TRUSTY=y
CONFIG_TRUSTY_IRQ=y
CONFIG_TRUSTY_LOG=y
CONFIG_TRUSTY_VIRTIO=y
CONFIG_TRUSTY_VIRTIO_IPC=y

# GSA security-coprocessor client (AoC firmware authenticate + start)
CONFIG_GSA=y
