		/*
		 * Source: PMU syscon address is from research/dumped.dts:15242-15246.
		 * Downstream uses "samsung,gs101-pmu", "syscon"; this minimal tree
		 * uses a Zumapro-specific syscon compatible so the watchdog can resolve
		 * its PMU phandle before an upstream Zumapro PMU driver exists.
		 */
		pmu_system_controller: system-controller@15460000 {
			compatible = "google,zumapro-pmu", "syscon";
			reg = <0x15460000 0x10000>;

			/*
			 * Where the bootloader takes the reboot mode from after
			 * a *warm* reset, same node and offset as gs101.  A cold
			 * reset clears this register, and then the bootloader
			 * reads the MAX77779 battery-backed scratchpad instead
			 * (nvmem-reboot-mode, see zumapro-tegu.dts) -- so the
			 * two stores are not redundant, they cover different
			 * reset types, which is why downstream's
			 * pixel-zuma-reboot.c writes both [HW 2026-08-10].  The
			 * values differ accordingly: the raw mode here, because
			 * a cold reset zeroes it, and the mode or'd with
			 * BMS_RSBM_VALID there, because battery-backed RAM has
			 * no power-on state and needs a validity marker.
			 *
			 * Reaching this register from EL1 is only possible
			 * because exynos-pmu registers an SMC-backed regmap as
			 * this node's syscon.
			 */
			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x0810>; /* EXYNOS_PMU_SYSIP_DAT0 */
				mode-bootloader = <0xfc>;
				mode-charge = <0x0a>;
				mode-dm-verity-device-corrupted = <0x50>;
				mode-fastboot = <0xfa>;
				mode-reboot-ab-update = <0x52>;
				mode-recovery = <0xff>;
				mode-rescue = <0xf9>;
				mode-shutdown-thermal = <0x51>;
				mode-shutdown-thermal-battery = <0x51>;
			};
		};

		/*
		 * Source: AP2APM mailbox base and IRQ are from the downstream
		 * ACPM node in research/dumped.dts:15292-15296 (reg 0x15110000,
		 * GIC SPI 80).  The register layout was hardware-verified by
		 * tracing the downstream kernel under the m1n1 hypervisor:
		 * doorbell = 1 << channel to INTGR1 (+0x40), AP-side ack/status
		 * on INTCR0/INTSR0, exactly the gs101 driver's model.  The
		 * mailbox pclk sits in the always-on APM block with no mainline
		 * CMU support; ext_24_5m stands in for it like the watchdog
		 * clocks below.
		 */
		ap2apm_mailbox: mailbox@15110000 {
			compatible = "google,zumapro-mbox", "google,gs101-mbox";
			reg = <0x15110000 0x1000>;
			clocks = <&ext_24_5m>;
			clock-names = "pclk";
			interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <0>;
		};

		pinctrl_gsacore4: pinctrl@16140000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x16140000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore0: pinctrl@16280000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x16280000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore1: pinctrl@16290000 {
