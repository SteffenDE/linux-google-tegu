		};

		pinctrl_eint: pinctrl@15060000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x15060000 0x1000>;
			status = "okay";

			gpn0: gpn0-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			gpn1: gpn1-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			gpn2: gpn2-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			gpn3: gpn3-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
