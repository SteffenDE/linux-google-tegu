# aoc_ipc is nested here (it is not a separate module in-tree)
ccflags-y	+= -I$(src)/aoc_ipc

obj-$(CONFIG_WC_MBOX)			+= mailbox-wc.o

obj-$(CONFIG_AOC_DRIVER)		+= aoc_core.o
# aoc_v1 is the AoC reset/power path (request_aoc_on, release-from-reset) and
# is the only implementation in the tree -- there is no aoc_v2. Downstream
# gates it on CONFIG_SOC_{GS101,GS201,ZUMA} for per-device builds; we follow
# the in-tree convention instead (no per-SoC symbol -- e.g. clk-zumapro.o
# builds under EXYNOS_ARM64_COMMON_CLK and matches via DT), so it is simply
# part of aoc_core, which is already CONFIG_AOC_DRIVER-gated.
aoc_core-objs	:= aoc.o aoc_ipc/aoc_ipc_core.o aoc_firmware.o \
		   ion_physical_heap.o aoc_service_core.o aoc_v1.o \
		   aoc_chipid_stub.o

obj-$(CONFIG_AOC_CHAR_DRIVER)		+= aoc_char_dev.o
obj-$(CONFIG_AOC_CONTROL_DRIVER)	+= aoc_control_dev.o
obj-$(CONFIG_AOC_CHAN_DRIVER)		+= aoc_channel_dev.o
obj-$(CONFIG_AOC_UWB_DRIVER)		+= aoc_uwb_platform_drv.o aoc_uwb_service_dev.o
obj-$(CONFIG_AOC_TBN_DRIVER)		+= aoc_tbn_service_dev.o
obj-$(CONFIG_AOC_UNIT_TEST_DRIVER)	+= aoc_unit_test_dev.o
