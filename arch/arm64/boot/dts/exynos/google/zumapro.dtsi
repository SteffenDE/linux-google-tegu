// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Tensor G4 "Zumapro" SoC skeleton.
 *
 * Hardware values are taken from the downstream Pixel 9a/Tegu dump in
 * ../../../../../../research/dumped.dts unless another source is named.
 */

#include <dt-bindings/clock/google,zumapro.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>
#include "zumapro-pinctrl.h"

/ {
	/*
	 * Source: downstream compatible strings are "google,ZUMA PRO TEGU",
	 * "google,ZUMA PRO" in research/dumped.dts:6.  The lowercase spelling
	 * follows the upstream convention documented in google.yaml.
	 */
	compatible = "google,zumapro";
	#address-cells = <2>;
	#size-cells = <1>;

	/* Source: interrupt-parent points at the GIC in research/dumped.dts:7. */
	interrupt-parent = <&gic>;

	/*
	 * Source: downstream aliases in research/dumped.dts:5759-5772.
	 * Keep the pinctrl aliases aligned with downstream controller numbering.
	 */
	aliases {
		pinctrl0 = &pinctrl_alive;
		pinctrl1 = &pinctrl_eint;
		pinctrl2 = &pinctrl_far_alive;
		pinctrl3 = &pinctrl_gsacore0;
		pinctrl4 = &pinctrl_gsacore1;
		pinctrl5 = &pinctrl_gsacore2;
		pinctrl6 = &pinctrl_gsacore3;
		pinctrl7 = &pinctrl_gsacore4;
		pinctrl8 = &pinctrl_hsi0;
		pinctrl9 = &pinctrl_hsi1;
		pinctrl10 = &pinctrl_hsi2;
		pinctrl11 = &pinctrl_peric0;
		pinctrl12 = &pinctrl_peric1;
		i2c6 = &hsi2c_6;
		i2c10 = &hsi2c_10;
		ufs0 = &ufs_0;
	};

	/*
	 * Source: downstream iommu_group_dpu in zumapro-sysmmu.dtsi and
	 * research/dumped.dts:762.  TRACE NEEDED: validate how the downstream
	 * v9 group driver maps DECON0's two DPUF System MMUs before wiring a
	 * mainline DECON node to this group.
	 */
	iommu_group_dpu: iommu-group-dpu {
		compatible = "samsung,sysmmu-group";
		status = "disabled";
	};

	/*
	 * Source: downstream iommu_group_aoc in research/dumped.dts:837.
	 * The AoC device references this group via samsung,iommu-group.
	 * Enabled (unlike the DPU group above) because AoC is being wired up.
	 */
	iommu_group_aoc: iommu-group-aoc {
		compatible = "samsung,sysmmu-group";
	};

	/*
	 * Source: GS101 upstream binding requires an empty ect node
	 * (Documentation/devicetree/bindings/arm/google.yaml).  The Zumapro
	 * downstream tree also has ECT reserved memory at dumped.dts:1320.
	 */
	ect {
	};

	/*
	 * Source: gs101.dtsi ACPM pattern.  Protocol identity with gs101 was
	 * hardware-verified on the Pixel 9a: the channel table at SRAM+0xa000
	 * parses with the mainline gs101 initdata structs (16 channels, PMIC
	 * on channel 2), and a full boot of the downstream kernel traced
	 * under the m1n1 hypervisor showed the identical doorbell/queue/PMIC
	 * wire protocol, so the gs101 fallback compatible drives the zumapro
	 * ACPM firmware unmodified.  See research/tracing/acpm-channels.md
	 * and research/tracing/acpm-boot-rail-snapshot.md.
	 */
	firmware {
		acpm_ipc: power-management {
			compatible = "google,zumapro-acpm-ipc",
				     "google,gs101-acpm-ipc";
			mboxes = <&ap2apm_mailbox>;
			shmem = <&apm_sram>;
			/*
			 * clk-acpm registers its ACPM-DVFS clocks against this
			 * node (the child clk device has no of_node, so the clk
			 * core falls back to the parent), so consumers reference
			 * them as <&acpm_ipc id>, where id is the ACPM DVFS
			 * domain index (e.g. 7 = G3D, 8 = G3DL2).
			 */
			#clock-cells = <1>;

		};
	};

	/*
	 * Trusty TEE.  SMC transport to the bootloader-started Trusty (TZSW);
	 * no MMIO.  Children are the IRQ forwarder, the log, and the virtio
	 * transport that carries tipc.  ipi-range mirrors research/dumped.dts
	 * (trusty/irq ipi-range = <8 15 8>).  Needed for the AoC GSA-hwmgr
	 * firmware-start path (docs/platform/aoc.md).
	 */
	trusty {
		compatible = "android,trusty-smc-v1";

		irq {
			compatible = "android,trusty-irq-v1";
			ipi-range = <8 15 8>;
		};

		log {
			compatible = "android,trusty-log-v1";
		};

		virtio {
			compatible = "android,trusty-virtio-v1";
		};
	};

	/*
	 * Google Security Authenticator (GSA) client.  Hardware mailbox at
	 * 0x16490000 for firmware-image authentication, plus a Trusty tipc
	 * channel (hwmgr) for coprocessor start.  The s2mpu phandle and the
	 * log-region / gsa_gsc child are omitted -- pKVM, GSC and the GSA log
	 * are disabled for this minimal bring-up.  Needed to authenticate and
	 * start AoC (docs/platform/aoc.md).  IRQ from research/dumped.dts
	 * (gsa-ns interrupts = <0 0x177 4>).
	 */
	gsa: gsa@16490000 {
		compatible = "google,gs101-gsa-v1";
		reg = <0x0 0x16490000 0x1000>;
		interrupts = <GIC_SPI 375 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	/*
	 * Whitechapel mailbox controllers for AoC.  Source: downstream
	 * mbox@15200000/15220000/15240000 in research/dumped.dts:13198-13232.
	 * Each carries 16 AoC<->AP channels; the AoC node below fans all 48
	 * out through them.  reg/interrupts/mbox-name and the
	 * wc-mbox-non-wake-channels mask are verbatim from the dump.
	 */
	aoc_mbox0: mbox@15200000 {
		compatible = "google,mailbox-whitechapel";
		reg = <0x0 0x15200000 0x1000>;
		interrupts = <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH 0>;
		mbox-name = "aoc_a32_ap";
		#mbox-cells = <1>;
		wc-mbox-non-wake-channels = <0xf000>;
	};

	aoc_mbox1: mbox@15220000 {
		compatible = "google,mailbox-whitechapel";
		reg = <0x0 0x15220000 0x1000>;
		interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH 0>;
		mbox-name = "aoc_f1_ap";
		#mbox-cells = <1>;
		wc-mbox-non-wake-channels = <0xf000>;
	};

	aoc_mbox2: mbox@15240000 {
		compatible = "google,mailbox-whitechapel";
		reg = <0x0 0x15240000 0x1000>;
		interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH 0>;
		mbox-name = "aoc_p6_ap";
		#mbox-cells = <1>;
		wc-mbox-non-wake-channels = <0xf000>;
	};

	/*
	 * SoC chip-id block.  Source: downstream chipid@10000000 in
	 * research/dumped.dts:14927 (reg verbatim).  No in-tree driver binds this
	 * compatible; the AoC chip-id reader (aoc_chipid.c) maps it to forward the
	 * SoC product-id/type/revision to AoC firmware via fw_data.
	 */
	chipid@10000000 {
		compatible = "google,zuma-chipid";
		reg = <0x0 0x10000000 0xd000>;
	};

	/*
	 * Always-On Compute coprocessor.  Source: downstream aoc@17000000 in
	 * research/dumped.dts:13234.  reg regions (blk_aoc, aoc_req, aoc_s2mpu,
	 * ssmt_aoc), the watchdog interrupt, the 48-channel mailbox fan-out and
	 * every scalar tuning word are verbatim from the dump.  Dropped from the
	 * dump: pinctrl-0/-names (driver never uses pinctrl; the phandle pointed
	 * at aoc-vsync-pins) and sensor_1v8/3v3-supply + sensor_power_list (would
	 * pull in regulators; sensor power is deferred).
	 */
	aoc: aoc@17000000 {
		compatible = "google,aoc";
		reg = <0x0 0x17000000 0x2000000>,
		      <0x0 0x154b0000 0x1000>,
		      <0x0 0x190c0000 0x1000>,
		      <0x0 0x19060000 0x5000>;
		reg-names = "blk_aoc", "aoc_req", "aoc_s2mpu", "ssmt_aoc";
		interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH 0>;
		interrupt-names = "watchdog";
		iommus = <&sysmmu_aoc>;
		samsung,iommu-group = <&iommu_group_aoc>;
		memory-region = <&aoc_reserved>;
		/* gsa-enabled = "true"; -- read as a bool; a string value warns */
		gsa-enabled;
		gsa-device = <&gsa>;
		mbox-channels = <48>;
		mbox-names = "aoc2ap";
		mboxes = <&aoc_mbox0 0>, <&aoc_mbox0 1>, <&aoc_mbox0 2>,
			 <&aoc_mbox0 3>, <&aoc_mbox0 4>, <&aoc_mbox0 5>,
			 <&aoc_mbox0 6>, <&aoc_mbox0 7>, <&aoc_mbox0 8>,
			 <&aoc_mbox0 9>, <&aoc_mbox0 10>, <&aoc_mbox0 11>,
			 <&aoc_mbox0 12>, <&aoc_mbox0 13>, <&aoc_mbox0 14>,
			 <&aoc_mbox0 15>,
			 <&aoc_mbox1 0>, <&aoc_mbox1 1>, <&aoc_mbox1 2>,
			 <&aoc_mbox1 3>, <&aoc_mbox1 4>, <&aoc_mbox1 5>,
			 <&aoc_mbox1 6>, <&aoc_mbox1 7>, <&aoc_mbox1 8>,
			 <&aoc_mbox1 9>, <&aoc_mbox1 10>, <&aoc_mbox1 11>,
			 <&aoc_mbox1 12>, <&aoc_mbox1 13>, <&aoc_mbox1 14>,
			 <&aoc_mbox1 15>,
			 <&aoc_mbox2 0>, <&aoc_mbox2 1>, <&aoc_mbox2 2>,
			 <&aoc_mbox2 3>, <&aoc_mbox2 4>, <&aoc_mbox2 5>,
			 <&aoc_mbox2 6>, <&aoc_mbox2 7>, <&aoc_mbox2 8>,
			 <&aoc_mbox2 9>, <&aoc_mbox2 10>, <&aoc_mbox2 11>,
			 <&aoc_mbox2 12>, <&aoc_mbox2 13>, <&aoc_mbox2 14>,
			 <&aoc_mbox2 15>;
		acpm-ipc-channel = <0x0d>;
		force-vnom = <0x00>;
		pcu-base = <0x1400000>;
		gpio-base = <0x1c00000>;
		pcu-db-set-offset = <0x1f004>;
		pcu-db-clr-offset = <0x1f008>;
		cp-aperture-start-offset = <0x7fdf80>;
		cp-aperture-end-offset = <0x7fffff>;
		clock-divider = <0x01>;
		channel-max-pending-msgs = <0x80>;
		block-channel-threshold = <0x40>;
		notify-on-state-transition = "true";
		hotword-supported = "true";
		chre-supported = "true";
		aoc-board-cfg = "TG4";
		aoc-board-id = <0x60b02>;
		aoc-board-rev = <0x10000>;
		prevent-fw-load = <0x00>;
		gnss-type = <0x02>;
	};

	/*
	 * ACPM TMU zones.  The ACPM firmware only *measures* on a bare boot (its
	 * throttling governor is configured by the downstream kernel, not the
	 * bootloader), so the CPU-cluster zones own throttling in Linux via
	 * cpufreq cooling under the power_allocator (IPA) PID governor -- the
	 * mainline analog of downstream's use-pi-thermal.  step_wise only
	 * limit-cycles on the fast X4; IPA holds the setpoint (HW-validated).
	 * Each CPU zone has a SINGLE passive control trip (the IPA setpoint,
	 * downstream BIG 90 / MID,LITTLE 95, dumped.dts:17894+) plus a critical
	 * backstop.  With one passive trip IPA runs always-on and its band is the
	 * control temperature itself, so estimate_pid_constants() derives gentle
	 * gains (k_po~17) -- a second "switch-on" passive trip narrows the band
	 * into steep gains and resets the PID integral whenever the fast X4 dips
	 * below it, collapsing the controller into a bang-bang relay (HW-confirmed
	 * 45<->100 C swing).  sustainable-power is measured per cluster with the
	 * S2MPG14 ODPM meter under an all-core load: BIG=1200 (its draw while IPA
	 * holds it at the 90 C trip); MID=1500 and LITTLE=1000 are the clusters'
	 * full-tilt power -- they only reach ~80/60 C, well below their 95 C trip,
	 * so their value is a never-actuated safety-net feed-forward.
	 * Cluster<->sensor: cpu7 (X4)=BIG tzid0, cpu4 (A720)=MID tzid1, cpu0
	 * (A520)=LITTLE tzid2.  G3D/ISP/TPU/AUR stay monitor-only.
	 *
	 * Trip *detection* is now the TMU interrupt's job: it fires when the zone
	 * leaves the thermal core's trip window, so a hard ramp no longer waits
	 * for a poll to be noticed.  polling-delay-passive stays at 25 ms because
	 * IPA's PID needs periodic samples once it is regulating; the interrupt
	 * arms that state immediately instead of up to a poll period late.
	 *
	 * polling-delay must NOT be 0, even with interrupts.  These zones have a
	 * single passive trip, so gov_power_allocator's setup leaves
	 * params->trip_switch_on NULL (it is the *first* of two or more passive
	 * trips), and power_allocator_manage() gates allow_maximum_power() on it.
	 * IPA therefore has no explicit release path here: it only unwinds a
	 * throttle through repeated allocate_power() calls as the zone cools.
	 * Once the zone drops out of the trip's hysteresis band tz->passive falls
	 * to 0 and the 25 ms passive poll stops, so with polling-delay = 0 nothing
	 * would ever run the governor again and the last cooling state would stick
	 * forever -- HW-observed: cpu7 pinned at 13/17 (1745 of 3105 MHz) at 41 C
	 * idle until something else poked the zone.  The cool-side poll is what
	 * releases the throttle, which is why 1 s is enough now that it no longer
	 * has to *detect* anything.  (Upstream gs101 can use 0 because its ladder
	 * has two passive trips, so allow_maximum_power() is reachable there.)
	 */
	thermal-zones {
		big-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <25>;
			thermal-sensors = <&tmu_top 0>;
			sustainable-power = <1200>;

			trips {
				/*
				 * Single passive trip = always-on IPA: the band is
				 * the control temperature itself (90 C), which makes
				 * estimate_pid_constants() derive gentle gains
				 * (k_po~17).  A second "switch-on" passive trip would
				 * narrow the band into steep gains AND reset the PID
				 * integral every time the fast X4 dips below it, which
				 * degrades the controller into a bang-bang relay
				 * (HW-confirmed).  This is also step_wise's throttle
				 * point when that fallback governor is selected.
				 */
				big_alert: throttle {
					temperature = <90000>;
					hysteresis = <5000>;
					type = "passive";
				};

				big_crit: critical {
					temperature = <115000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&big_alert>;
					cooling-device = <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		mid-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <25>;
			thermal-sensors = <&tmu_top 1>;
			/*
			 * Measured ~1500 mW full-tilt (ODPM, all-core load); MID
			 * peaks ~80 C, 15 C below its control trip, so like LITTLE
			 * this is a never-actuated safety-net feed-forward.
			 */
			sustainable-power = <1500>;

			trips {
				/* Always-on IPA, single passive trip; see big-thermal. */
				mid_alert: throttle {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "passive";
				};

				mid_crit: critical {
					temperature = <115000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&mid_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		little-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <25>;
			thermal-sensors = <&tmu_top 2>;
			/*
			 * Measured ~1000 mW full-tilt (ODPM, all-core load -- the
			 * EM estimate of ~440 mW was ~2x low for the A520).  LITTLE
			 * peaks ~60 C, 35 C below its control trip, so this never
			 * actuates; it is a safety-net feed-forward only.
			 */
			sustainable-power = <1000>;

			trips {
				/* Always-on IPA, single passive trip; see big-thermal. */
				little_alert: throttle {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "passive";
				};

				little_crit: critical {
					temperature = <115000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&little_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		g3d-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&tmu_sub 0>;
		};

		isp-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&tmu_sub 1>;
		};

		tpu-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&tmu_sub 2>;
		};

		aur-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&tmu_sub 3>;
		};
	};

	/*
	 * Source: dumped.dts:7858-7863. The pre-guest m1n1 readout shows
	 * gpp0-1 is an output but low at handoff, so Linux must assert this
	 * fixed-regulator GPIO before UFS link startup.
	 */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		enable-active-high;
	};

	/*
	 * Placeholder supply for rails that are real but not yet driver-managed,
	 * mirroring the gs101 reg_placeholder approach.  The USB controller/PHY
	 * rails (downstream m_ldo8/m_ldo9/m_ldo19 under sub_pd_hsi0, left enabled
	 * by the bootloader) are wired here so the mainline drivers'
	 * regulator_get() calls resolve to a real fixed supply rather than an
	 * implicit dummy.
	 *
	 * TODO: replace with the real s2mpg14/15 PMIC rails once that driver
	 * exists.  Expected mapping: vdd -> m_ldo8, vdda12 -> m_ldo9, and
	 * vdd33 (plus the eUSB repeater) -> m_ldo19.
	 */
	reg_placeholder: regulator-placeholder {
		compatible = "regulator-fixed";
		regulator-name = "placeholder_reg";
	};

	cpus {
		/*
		 * Source: CPU address/size cells match research/dumped.dts:3065-3066.
		 */
		#address-cells = <2>;
		#size-cells = <0>;

		/*
		 * Source: downstream cpu-map is flattened in dumped.dts:3068-3106,
		 * while the cluster grouping below follows downstream cpupm/acme
		 * sibling CPU groups in dumped.dts:3248-3275 and 3327-3369.
		 */
		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
					cpu = <&cpu2>;
				};
				core3 {
					cpu = <&cpu3>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu4>;
				};
				core1 {
					cpu = <&cpu5>;
				};
				core2 {
					cpu = <&cpu6>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&cpu7>;
				};
			};
		};

		/*
		 * Source: reg, enable-method, idle-state assignment, capacity, and
		 * dynamic power values are copied from research/dumped.dts:3108-3188.
		 * Downstream only reports compatible = "arm,armv9.2"; the concrete
		 * Cortex compatibles below are inferred from the downstream Hayes,
		 * Hunter, and Hunter-ELP idle-state names at dumped.dts:3198,
		 * dumped.dts:3210, and dumped.dts:3222.  Verify against MIDR on
		 * hardware before treating the CPU compatible strings as final.
		 */
		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x0 0x0>;
			clocks = <&acpm_ipc 2>;
			operating-points-v2 = <&cpucl0_opp_table>;
			enable-method = "psci";
			cpu-idle-states = <&hayes_cpu_sleep>;
			capacity-dmips-mhz = <0xc1>;
			dynamic-power-coefficient = <0x46>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x0 0x100>;
			clocks = <&acpm_ipc 2>;
			operating-points-v2 = <&cpucl0_opp_table>;
			enable-method = "psci";
			cpu-idle-states = <&hayes_cpu_sleep>;
			capacity-dmips-mhz = <0xc1>;
			dynamic-power-coefficient = <0x46>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x0 0x200>;
			clocks = <&acpm_ipc 2>;
			operating-points-v2 = <&cpucl0_opp_table>;
			enable-method = "psci";
			cpu-idle-states = <&hayes_cpu_sleep>;
			capacity-dmips-mhz = <0xc1>;
			dynamic-power-coefficient = <0x46>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x0 0x300>;
			clocks = <&acpm_ipc 2>;
			operating-points-v2 = <&cpucl0_opp_table>;
			enable-method = "psci";
			cpu-idle-states = <&hayes_cpu_sleep>;
			capacity-dmips-mhz = <0xc1>;
			dynamic-power-coefficient = <0x46>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x0 0x400>;
			clocks = <&acpm_ipc 3>;
			operating-points-v2 = <&cpucl1_opp_table>;
			enable-method = "psci";
			cpu-idle-states = <&hunter_cpu_sleep>;
			capacity-dmips-mhz = <0x39f>;
			dynamic-power-coefficient = <0x201>;
			#cooling-cells = <2>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x0 0x500>;
			clocks = <&acpm_ipc 3>;
			operating-points-v2 = <&cpucl1_opp_table>;
			enable-method = "psci";
			cpu-idle-states = <&hunter_cpu_sleep>;
			capacity-dmips-mhz = <0x39f>;
			dynamic-power-coefficient = <0x201>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x0 0x600>;
			clocks = <&acpm_ipc 3>;
			operating-points-v2 = <&cpucl1_opp_table>;
			enable-method = "psci";
			cpu-idle-states = <&hunter_cpu_sleep>;
			capacity-dmips-mhz = <0x39f>;
			dynamic-power-coefficient = <0x201>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-x4";
			reg = <0x0 0x700>;
			clocks = <&acpm_ipc 4>;
			operating-points-v2 = <&cpucl2_opp_table>;
			enable-method = "psci";
			cpu-idle-states = <&hunterelp_cpu_sleep>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x2f5>;
			#cooling-cells = <2>;
		};

		idle-states {
			/*
			 * Source: idle-state values come from research/dumped.dts:3195-3228.
			 * entry-method is normalized to "psci" per psci.yaml; downstream
			 * used "arm,psci".
			 */
			entry-method = "psci";

			hayes_cpu_sleep: cpu-hayes-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x46>;
				exit-latency-us = <0xa0>;
				min-residency-us = <0x7d0>;
			};

			hunter_cpu_sleep: cpu-hunter-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x96>;
				exit-latency-us = <0xbe>;
				min-residency-us = <0x9c4>;
			};

			hunterelp_cpu_sleep: cpu-hunterelp-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0xeb>;
				exit-latency-us = <0xdc>;
				min-residency-us = <0xdac>;
			};
		};
	};

	/*
	 * CPU operating points for the three clusters.  Frequencies are the
	 * downstream pixel-em "default" profile (research/dumped.dts:3360, the
	 * cpu0/cpu4/cpu7 ladders) and match the exynos-acme per-domain
	 * min/max-freq at research/dumped.dts:3326-3370.  The supplying clock is
	 * the ACPM DVFS domain for each cluster (CPUCL0/1/2 = ids 2/3/4 per
	 * private/.../cal-if/zuma/acpm_dvfs_zuma.h), so ACPM owns the rail
	 * voltage; cpufreq-dt binds via the platdev fallback once cpu@0 has
	 * operating-points-v2.
	 *
	 * opp-microvolt is NOT actuated here: the CPUs carry no cpu-supply, so the
	 * OPP core never programs a rail (ACPM still owns voltage).  It exists only
	 * so cpufreq-dt builds an Energy Model (P = C*V^2*f), which makes the
	 * cpufreq cooling devices power actors so the thermal power_allocator (IPA)
	 * governor can hold the CPU zones at their trip instead of letting step_wise
	 * oscillate.  These values are an ESTIMATED monotonic V/f curve (~0.6 V min
	 * to ~1.05 V max); IPA's feedback tolerates the approximation.
	 * TODO: replace with the real per-chip ASV ladder read from the ACPM fvmap
	 * at runtime (a small fvmap-reader EM driver; see docs/subsystems/power/reference/thermal-acpm-tmu.md).
	 */
	cpucl0_opp_table: opp-table-cpucl0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-820000000  { opp-hz = /bits/ 64 <820000000>;  opp-microvolt = <600000>; };
		opp-955000000  { opp-hz = /bits/ 64 <955000000>;  opp-microvolt = <625000>; };
		opp-1098000000 { opp-hz = /bits/ 64 <1098000000>; opp-microvolt = <650000>; };
		opp-1197000000 { opp-hz = /bits/ 64 <1197000000>; opp-microvolt = <675000>; };
		opp-1328000000 { opp-hz = /bits/ 64 <1328000000>; opp-microvolt = <700000>; };
		opp-1425000000 { opp-hz = /bits/ 64 <1425000000>; opp-microvolt = <725000>; };
		opp-1548000000 { opp-hz = /bits/ 64 <1548000000>; opp-microvolt = <755000>; };
		opp-1696000000 { opp-hz = /bits/ 64 <1696000000>; opp-microvolt = <800000>; };
		opp-1849000000 { opp-hz = /bits/ 64 <1849000000>; opp-microvolt = <850000>; };
		opp-1950000000 { opp-hz = /bits/ 64 <1950000000>; opp-microvolt = <900000>; };
	};

	cpucl1_opp_table: opp-table-cpucl1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-357000000  { opp-hz = /bits/ 64 <357000000>;  opp-microvolt = <575000>; };
		opp-578000000  { opp-hz = /bits/ 64 <578000000>;  opp-microvolt = <600000>; };
		opp-648000000  { opp-hz = /bits/ 64 <648000000>;  opp-microvolt = <615000>; };
		opp-787000000  { opp-hz = /bits/ 64 <787000000>;  opp-microvolt = <640000>; };
		opp-910000000  { opp-hz = /bits/ 64 <910000000>;  opp-microvolt = <665000>; };
		opp-1065000000 { opp-hz = /bits/ 64 <1065000000>; opp-microvolt = <690000>; };
		opp-1221000000 { opp-hz = /bits/ 64 <1221000000>; opp-microvolt = <715000>; };
		opp-1328000000 { opp-hz = /bits/ 64 <1328000000>; opp-microvolt = <740000>; };
		opp-1418000000 { opp-hz = /bits/ 64 <1418000000>; opp-microvolt = <765000>; };
		opp-1549000000 { opp-hz = /bits/ 64 <1549000000>; opp-microvolt = <790000>; };
		opp-1795000000 { opp-hz = /bits/ 64 <1795000000>; opp-microvolt = <825000>; };
		opp-1945000000 { opp-hz = /bits/ 64 <1945000000>; opp-microvolt = <850000>; };
		opp-2130000000 { opp-hz = /bits/ 64 <2130000000>; opp-microvolt = <890000>; };
		opp-2245000000 { opp-hz = /bits/ 64 <2245000000>; opp-microvolt = <915000>; };
		opp-2367000000 { opp-hz = /bits/ 64 <2367000000>; opp-microvolt = <940000>; };
		opp-2450000000 { opp-hz = /bits/ 64 <2450000000>; opp-microvolt = <965000>; };
		opp-2600000000 { opp-hz = /bits/ 64 <2600000000>; opp-microvolt = <1000000>; };
	};

	cpucl2_opp_table: opp-table-cpucl2 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-700000000  { opp-hz = /bits/ 64 <700000000>;  opp-microvolt = <600000>; };
		opp-1164000000 { opp-hz = /bits/ 64 <1164000000>; opp-microvolt = <640000>; };
		opp-1396000000 { opp-hz = /bits/ 64 <1396000000>; opp-microvolt = <665000>; };
		opp-1557000000 { opp-hz = /bits/ 64 <1557000000>; opp-microvolt = <690000>; };
		opp-1745000000 { opp-hz = /bits/ 64 <1745000000>; opp-microvolt = <715000>; };
		opp-1885000000 { opp-hz = /bits/ 64 <1885000000>; opp-microvolt = <740000>; };
		opp-1999000000 { opp-hz = /bits/ 64 <1999000000>; opp-microvolt = <765000>; };
		opp-2147000000 { opp-hz = /bits/ 64 <2147000000>; opp-microvolt = <790000>; };
		opp-2294000000 { opp-hz = /bits/ 64 <2294000000>; opp-microvolt = <815000>; };
		opp-2363000000 { opp-hz = /bits/ 64 <2363000000>; opp-microvolt = <840000>; };
		opp-2499000000 { opp-hz = /bits/ 64 <2499000000>; opp-microvolt = <865000>; };
		opp-2687000000 { opp-hz = /bits/ 64 <2687000000>; opp-microvolt = <900000>; };
		opp-2802000000 { opp-hz = /bits/ 64 <2802000000>; opp-microvolt = <940000>; };
		opp-2914000000 { opp-hz = /bits/ 64 <2914000000>; opp-microvolt = <975000>; };
		opp-2943000000 { opp-hz = /bits/ 64 <2943000000>; opp-microvolt = <990000>; };
		opp-2970000000 { opp-hz = /bits/ 64 <2970000000>; opp-microvolt = <1000000>; };
		opp-3015000000 { opp-hz = /bits/ 64 <3015000000>; opp-microvolt = <1025000>; };
		opp-3105000000 { opp-hz = /bits/ 64 <3105000000>; opp-microvolt = <1050000>; };
	};

	/*
	 * Source: fixed clock frequencies/names are from research/dumped.dts:15042-15070.
	 *
	 * ext_24_5m is the 24.576 MHz oscillator (fin_pll / OSCCLK), the PLL and
	 * CMU reference: downstream cal-if sets FIN_HZ_24P576M and the device's
	 * debugfs reads fin_pll = 24576000.  This is the clock the CMU "oscclk"
	 * inputs use.  Do NOT confuse it with ext_26m below, which is the separate
	 * 26 MHz TCXO (UMUX_CLKCMU_HSI0_TCXO) and is not the CMU oscclk.
	 */
	ext_24_5m: clock-24576000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24576000>;
		clock-output-names = "oscclk";
	};

	ext_26m: clock-26000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "ext-26m";
	};

	ext_1m: clock-1000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <1000000>;
		clock-output-names = "ext-1m";
	};

	/*
	 * BLK_ALIVE APM_USI1 UART (uart18 = Bluetooth HCI) baud clock.
	 * Downstream dmesg reports "155d0000.serial: Clock rate : 200000000".
	 * CMU_APM is not modeled yet and this rail is owned by ACPM and left
	 * running, so model it as a fixed-clock; replace with the real
	 * DOUT_CLK_APM_USI1_UART once CMU_APM lands.
	 */
	apm_usi1_uart_clk: clock-200000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
		clock-output-names = "apm_usi1_uart";
	};

	/*
	 * Source: PSCI compatible/method are from research/dumped.dts:3235-3239.
	 */
	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	/*
	 * GPU (Mali-G715 / Tensor G4 "G3D") PM domains.  Source: downstream
	 * research/dumped_uart.dts:2699-2719 and the Phase-0 power-on trace
	 * (docs/subsystems/gpu/reference/gpu-power-trace-results.md).  Two domains: pd_g3d (top, the
	 * EL3-protected PMU register -> secure SMC path) and pd_embedded_g3d
	 * (the shader cores, a child of pd_g3d).
	 *
	 * Both are samsung,always-on.  On silicon the bootloader hands the GPU
	 * over fully powered (both PMU status regs 0x15461a84/0x15461c84 read 1),
	 * and the mainline power-OFF sequence times out on the cores domain (the
	 * CMU handshake the downstream pmucal performs around the transition is
	 * not yet replicated here), so genpd_power_off_unused cannot gate them.
	 * For first light we adopt the live, powered state (as the display splash
	 * pipeline does) instead of exercising an unproven off->on cycle; real
	 * runtime-PM power-cycling can drop always-on once the off-sequence works.
	 */
	pd_g3d: power-domain@15461a80 {
		compatible = "google,zumapro-pd";
		reg = <0x0 0x15461a80 0x20>,
		      <0x0 0x1ee00800 0x4>;
		reg-names = "pmu", "cmu";
		samsung,secure-pd-id = <0x1ee10204>;
		samsung,always-on;
		#power-domain-cells = <0>;
		label = "G3D";
	};

	pd_embedded_g3d: power-domain@15461c80 {
		compatible = "google,zumapro-pd";
		reg = <0x0 0x15461c80 0x20>;
		reg-names = "pmu";
		power-domains = <&pd_g3d>;
		samsung,always-on;
		#power-domain-cells = <0>;
		label = "G3D_CORES";
	};

	/*
	 * Display PM domains.  Source: downstream zumapro-pm-domains.dtsi and
	 * research/dumped.dts:2721-2754.  Keep disabled until the display clock,
	 * SysMMU, DSIM, and DECON drivers can consume them together; enabling
	 * these too early could hand genpd control of the bootloader splash path.
	 */
	pd_dpub: power-domain@15461d00 {
		compatible = "google,zumapro-pd";
		reg = <0x0 0x15461d00 0x20>,
		      <0x0 0x19400800 0x4>;
		reg-names = "pmu", "cmu";
		samsung,secure-pd-id = <0x19410204>;
		samsung,always-on;
		#power-domain-cells = <0>;
		label = "DPUB";
		status = "disabled";
	};

	pd_dpuf0: power-domain@15461d80 {
		compatible = "google,zumapro-pd";
		reg = <0x0 0x15461d80 0x20>,
		      <0x0 0x19800800 0x4>;
		reg-names = "pmu", "cmu";
		samsung,secure-pd-id = <0x19810204>;
		samsung,always-on;
		#power-domain-cells = <0>;
		power-domains = <&pd_dpub>;
		label = "DPUF0";
		status = "disabled";
	};

	pd_dpuf1: power-domain@15461e00 {
		compatible = "google,zumapro-pd";
		reg = <0x0 0x15461e00 0x20>,
		      <0x0 0x19c00800 0x4>;
		reg-names = "pmu", "cmu";
		samsung,secure-pd-id = <0x19c10204>;
		samsung,always-on;
		#power-domain-cells = <0>;
		power-domains = <&pd_dpub>;
		label = "DPUF1";
		status = "disabled";
	};

	/*
	 * BLK_HSI1 hosts the modem's PCIe CH0 root complex (Gen3 x2).
	 * Downstream leaves its exynos-pd node disabled (the domain is never
	 * kernel-managed there, and ACPM has a dedicated SYS_SLEEP_HSI1ON
	 * suspend mode for when the modem link stays up), so model it
	 * always-on: if the bootloader hands the domain over powered this is
	 * a no-op, and if not, genpd powers it up before the CMU_HSI1/PCIe
	 * probes touch the block.  PMU offset and secure ID are from
	 * research/dumped.dts:2927-2936 (pd-hsi1@15462B00: need_smc
	 * 0x12010204, cmu_id 0x12000000).
	 */
	pd_hsi1: power-domain@15462b00 {
		compatible = "google,zumapro-pd";
		reg = <0x0 0x15462b00 0x20>,
		      <0x0 0x12000800 0x4>;
		reg-names = "pmu", "cmu";
		samsung,secure-pd-id = <0x12010204>;
		samsung,always-on;
		#power-domain-cells = <0>;
		label = "HSI1";
	};

	soc: soc@0 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * Source: bus shape follows upstream GS101 in gs101.dtsi:529-532.
		 * The 0x40000000 span covers the MMIO addresses used below from the
		 * downstream dump.  The second window passes through the PCIe CH1
		 * outbound + ECAM region at 0x6000_0000..0x6100_0000 (the pcie@13120000
		 * "config" reg and "ranges" memory window) which lives above the first
		 * span; without it of_translate_address() returns OF_BAD_ADDR for those.
		 */
		ranges = <0x0 0x0 0x0 0x40000000>,
			 /*
			  * PCIe CH0 (modem) outbound + ECAM window: the
			  * pcie@12100000 "config" reg (0x40ffe000) and its
			  * memory window (CPU 0x40000000 -> PCI 0x14e00000)
			  * start exactly at the top of the first span.
			  */
			 <0x40000000 0x0 0x40000000 0x1000000>,
			 <0x60000000 0x0 0x60000000 0x1000000>;

		/*
		 * Source: downstream CMU_TOP block base/size and PERIC0 parent
		 * registers are from the Zuma cmucal-sfr.c tables.  This first
		 * upstream clock slice only exposes the PERIC0 feeds used by the
		 * already-working debug UART.
		 */
		cmu_top: clock-controller@26040000 {
			compatible = "google,zumapro-cmu-top";
			reg = <0x26040000 0x10000>;
			#clock-cells = <1>;
			clocks = <&ext_24_5m>;
			clock-names = "oscclk";
		};

		/*
		 * CMU_MISC clocks the Multi-Core Timer (MCT).  Modelled only far
		 * enough to gate the MCT register-access pclk; the NOC USER mux
		 * selects either the oscillator or the CMU_TOP MISC feed.
		 */
		cmu_misc: clock-controller@10010000 {
			compatible = "google,zumapro-cmu-misc";
			reg = <0x10010000 0x10000>;
			#clock-cells = <1>;
			clocks = <&ext_24_5m>,
				 <&cmu_top CLK_DOUT_CMU_MISC_NOC>;
			clock-names = "oscclk", "bus";
		};

		/*
		 * The two TMU instances.  The firmware owns the TMU: the AP maps
		 * only the INTPEND registers and takes the interrupt, and does
		 * temperatures, thresholds and IRQ acknowledge over ACPM IPC
		 * channel 9 (hardware-verified,
		 * research/tracing/acpm-channels.md).
		 *
		 * The thermal-sensor cell is the index local to each instance;
		 * the driver maps it to the global firmware tzid.  Sources:
		 * downstream BIG/MID/LITTLE@100A0000 and G3D/ISP/TPU/AUR@100B0000
		 * (research/dumped.dts:17702-17878).
		 *
		 * No clocks property: the TMU APB PCLK gates the INTPEND reads,
		 * but CMU_MISC has no TMU gates modelled yet and the bootloader
		 * leaves the clock running.  See docs/subsystems/power/reference/thermal-acpm-tmu.md.
		 */
		tmu_top: tmu@100a0000 {
			compatible = "google,zumapro-tmu-top";
			reg = <0x100a0000 0x800>;
			interrupts = <GIC_SPI 787 IRQ_TYPE_LEVEL_HIGH 0>;
			samsung,acpm-ipc = <&acpm_ipc>;
			#thermal-sensor-cells = <1>;
		};

		tmu_sub: tmu@100b0000 {
			compatible = "google,zumapro-tmu-sub";
			reg = <0x100b0000 0x800>;
			interrupts = <GIC_SPI 804 IRQ_TYPE_LEVEL_HIGH 0>;
			samsung,acpm-ipc = <&acpm_ipc>;
			#thermal-sensor-cells = <1>;
		};

		/*
		 * CMU_HSI0 feeds the USB block (DWC3 + USB-DRD/eUSB PHY).  The
		 * base and the CMU_TOP NOC feed come from research/dumped.dts and
		 * the downstream zuma cmucal tables.  The USB reference clock is
		 * not a CMU_TOP feed; it is derived from the CMU_HSI0-internal
		 * PLL_USB (see clk-zumapro.c and docs/archive/usb/needs-hardware-2026-05.md).
		 * USB is already running at fastboot handoff.
		 */
		cmu_hsi0: clock-controller@11000000 {
			compatible = "google,zumapro-cmu-hsi0";
			reg = <0x11000000 0x10000>;
			#clock-cells = <1>;
			clocks = <&ext_24_5m>,
				 <&cmu_top CLK_DOUT_CMU_HSI0_NOC>,
				 <&cmu_top CLK_DOUT_CMU_HSI0_PERI>;
			clock-names = "oscclk", "noc", "peri";
		};

		/*
		 * Source: display CMU bases come from dumped.dts pd-dpub,
		 * pd-dpuf0, and pd-dpuf1 cmu_id values; register offsets come
		 * from downstream Zuma CMUCAL.  TRACE NEEDED: validate selected
		 * display mux parents/rates under Linux before allowing DRM to
		 * program those clocks.
		 */
		cmu_dpub: clock-controller@19400000 {
			compatible = "google,zumapro-cmu-dpub";
			reg = <0x19400000 0x10000>;
			#clock-cells = <1>;
			clocks = <&ext_24_5m>,
				 <&cmu_top CLK_DOUT_CMU_DPUB_NOC>,
				 <&cmu_top CLK_DOUT_CMU_DPUB_DSIM>;
			clock-names = "oscclk", "bus", "dsim";
			power-domains = <&pd_dpub>;
			status = "disabled";
		};

		cmu_dpuf0: clock-controller@19800000 {
			compatible = "google,zumapro-cmu-dpuf0";
			reg = <0x19800000 0x8000>;
			#clock-cells = <1>;
			clocks = <&ext_24_5m>,
				 <&cmu_top CLK_DOUT_CMU_DPUF0_NOC>;
			clock-names = "oscclk", "bus";
			power-domains = <&pd_dpuf0>;
			status = "disabled";
		};

		cmu_dpuf1: clock-controller@19c00000 {
			compatible = "google,zumapro-cmu-dpuf1";
			reg = <0x19c00000 0x8000>;
			#clock-cells = <1>;
			clocks = <&ext_24_5m>,
				 <&cmu_top CLK_DOUT_CMU_DPUF1_NOC>;
			clock-names = "oscclk", "bus";
			power-domains = <&pd_dpuf1>;
			status = "disabled";
		};

		/*
		 * Source: downstream sysmmu_dpuf0/sysmmu_dpuf1 in
		 * zumapro-sysmmu.dtsi and research/dumped.dts:882-916.  These
		 * are Samsung System MMU v9 blocks, not compatible with the
		 * legacy mainline Exynos System MMU driver.  Keep them disabled
		 * until the v9 driver can program the PMMU stream tables and
		 * secure fault registers.
		 */
		sysmmu_dpuf0: iommu@19840000 {
			compatible = "samsung,sysmmu-v9";
			reg = <0x19840000 0x10000>;
			interrupts = <GIC_SPI 277 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 278 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&pd_dpuf0>;
			samsung,qos = <15>;
			samsung,secure-irq;
			samsung,secure-base = <0x19850000>;
			samsung,port-name = "DPU F0";
			samsung,pmmu0-default-stream = <0x600014a>;
			samsung,pmmu0-stream-property =
				<0x01 0x600014a 0x101 0x40 0x7f>,
				<0x02 0xa01011b 0x101 0x01 0x7f>,
				<0x03 0xa01011b 0x101 0x41 0x7f>,
				<0x04 0x2015a 0x101 0x08 0x7f>,
				<0x05 0x2015a 0x101 0x48 0x7f>,
				<0x06 0x103015a 0x101 0x0c 0x7f>,
				<0x07 0x103015a 0x101 0x4c 0x7f>,
				<0x08 0xb04011b 0x101 0x09 0x7f>,
				<0x09 0xb04011b 0x101 0x49 0x7f>,
				<0x0a 0xc05010b 0x101 0x0d 0x7f>,
				<0x0b 0xc05010b 0x101 0x4d 0x7f>,
				<0x0c 0x706013a 0x101 0x10 0x7f>,
				<0x0d 0x706010a 0x101 0x50 0x7f>,
				<0x0e 0xd07011b 0x101 0x11 0x7f>,
				<0x0f 0xd07011b 0x101 0x51 0x7f>,
				<0x10 0x208015a 0x101 0x18 0x7f>,
				<0x11 0x208015a 0x101 0x58 0x7f>,
				<0x12 0x309015a 0x101 0x1c 0x7f>,
				<0x13 0x309015a 0x101 0x5c 0x7f>,
				<0x14 0xe0a011b 0x101 0x19 0x7f>,
				<0x15 0xe0a011b 0x101 0x59 0x7f>,
				<0x16 0xf0b010b 0x101 0x1d 0x7f>,
				<0x17 0xf0b010b 0x101 0x5d 0x7f>,
				<0x18 0x140c010b 0x101 0x13 0x7f>,
				<0x19 0x140c010b 0x101 0x53 0x7f>,
				<0x1a 0x150d010b 0x101 0x0b 0x7f>,
				<0x1b 0x150d010b 0x101 0x4b 0x7f>,
