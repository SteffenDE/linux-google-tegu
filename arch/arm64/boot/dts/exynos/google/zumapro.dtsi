// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Tensor G4 "Zumapro" SoC skeleton.
 *
 * Hardware values are taken from the downstream Pixel 9a/Tegu dump in
 * ../../../../../../research/dumped.dts unless another source is named.
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "zumapro-pinctrl.h"

/ {
	/*
	 * Source: downstream compatible strings are "google,ZUMA PRO TEGU",
	 * "google,ZUMA PRO" in research/dumped.dts:6.  The lowercase spelling
	 * follows the upstream convention documented in google.yaml.
	 */
	compatible = "google,zumapro";
	#address-cells = <2>;
	#size-cells = <1>;

	/* Source: interrupt-parent points at the GIC in research/dumped.dts:7. */
	interrupt-parent = <&gic>;

	/*
	 * Source: downstream aliases in research/dumped.dts:5759-5772.
	 * The pinctrl controller nodes are placeholders until a Zumapro bank
	 * description exists in the upstream Samsung pinctrl driver.
	 */
	aliases {
		pinctrl0 = &pinctrl_alive;
		pinctrl1 = &pinctrl_eint;
		pinctrl2 = &pinctrl_far_alive;
		pinctrl3 = &pinctrl_gsacore0;
		pinctrl4 = &pinctrl_gsacore1;
		pinctrl5 = &pinctrl_gsacore2;
		pinctrl6 = &pinctrl_gsacore3;
		pinctrl7 = &pinctrl_gsacore4;
		pinctrl8 = &pinctrl_hsi0;
		pinctrl9 = &pinctrl_hsi1;
		pinctrl10 = &pinctrl_hsi2;
		pinctrl11 = &pinctrl_peric0;
		pinctrl12 = &pinctrl_peric1;
	};

	/*
	 * Source: GS101 upstream binding requires an empty ect node
	 * (Documentation/devicetree/bindings/arm/google.yaml).  The Zumapro
	 * downstream tree also has ECT reserved memory at dumped.dts:1320.
	 */
	ect {
	};

	cpus {
		/*
		 * Source: CPU address/size cells match research/dumped.dts:3065-3066.
		 */
		#address-cells = <2>;
		#size-cells = <0>;

		/*
		 * Source: downstream cpu-map is flattened in dumped.dts:3068-3106,
		 * while the cluster grouping below follows downstream cpupm/acme
		 * sibling CPU groups in dumped.dts:3248-3275 and 3327-3369.
		 */
		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
					cpu = <&cpu2>;
				};
				core3 {
					cpu = <&cpu3>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu4>;
				};
				core1 {
					cpu = <&cpu5>;
				};
				core2 {
					cpu = <&cpu6>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&cpu7>;
				};
			};
		};

		/*
		 * Source: reg, enable-method, idle-state assignment, capacity, and
		 * dynamic power values are copied from research/dumped.dts:3108-3188.
		 * Downstream only reports compatible = "arm,armv9.2"; the concrete
		 * Cortex compatibles below are inferred from the downstream Hayes,
		 * Hunter, and Hunter-ELP idle-state names at dumped.dts:3198,
		 * dumped.dts:3210, and dumped.dts:3222.  Verify against MIDR on
		 * hardware before treating the CPU compatible strings as final.
		 */
		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x0 0x0>;
			enable-method = "psci";
			cpu-idle-states = <&hayes_cpu_sleep>;
			capacity-dmips-mhz = <0xc1>;
			dynamic-power-coefficient = <0x46>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x0 0x100>;
			enable-method = "psci";
			cpu-idle-states = <&hayes_cpu_sleep>;
			capacity-dmips-mhz = <0xc1>;
			dynamic-power-coefficient = <0x46>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x0 0x200>;
			enable-method = "psci";
			cpu-idle-states = <&hayes_cpu_sleep>;
			capacity-dmips-mhz = <0xc1>;
			dynamic-power-coefficient = <0x46>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x0 0x300>;
			enable-method = "psci";
			cpu-idle-states = <&hayes_cpu_sleep>;
			capacity-dmips-mhz = <0xc1>;
			dynamic-power-coefficient = <0x46>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x0 0x400>;
			enable-method = "psci";
			cpu-idle-states = <&hunter_cpu_sleep>;
			capacity-dmips-mhz = <0x39f>;
			dynamic-power-coefficient = <0x201>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x0 0x500>;
			enable-method = "psci";
			cpu-idle-states = <&hunter_cpu_sleep>;
			capacity-dmips-mhz = <0x39f>;
			dynamic-power-coefficient = <0x201>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x0 0x600>;
			enable-method = "psci";
			cpu-idle-states = <&hunter_cpu_sleep>;
			capacity-dmips-mhz = <0x39f>;
			dynamic-power-coefficient = <0x201>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-x4";
			reg = <0x0 0x700>;
			enable-method = "psci";
			cpu-idle-states = <&hunterelp_cpu_sleep>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x2f5>;
		};

		idle-states {
			/*
			 * Source: idle-state values come from research/dumped.dts:3195-3228.
			 * entry-method is normalized to "psci" per psci.yaml; downstream
			 * used "arm,psci".
			 */
			entry-method = "psci";

			hayes_cpu_sleep: cpu-hayes-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x46>;
				exit-latency-us = <0xa0>;
				min-residency-us = <0x7d0>;
			};

			hunter_cpu_sleep: cpu-hunter-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x96>;
				exit-latency-us = <0xbe>;
				min-residency-us = <0x9c4>;
			};

			hunterelp_cpu_sleep: cpu-hunterelp-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0xeb>;
				exit-latency-us = <0xdc>;
				min-residency-us = <0xdac>;
			};
		};
	};

	/*
	 * Source: fixed clock frequencies/names are from research/dumped.dts:15042-15070.
	 *
	 * ext_24_5m is the 24.576 MHz oscillator (fin_pll / OSCCLK), the PLL and
	 * CMU reference: downstream cal-if sets FIN_HZ_24P576M and the device's
	 * debugfs reads fin_pll = 24576000.  This is the clock the CMU "oscclk"
	 * inputs use.  Do NOT confuse it with ext_26m below, which is the separate
	 * 26 MHz TCXO (UMUX_CLKCMU_HSI0_TCXO) and is not the CMU oscclk.
	 */
	ext_24_5m: clock-24576000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24576000>;
		clock-output-names = "ext-24_5m";
	};

	ext_200m: clock-200000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
		clock-output-names = "ext-200m";
	};

	ext_26m: clock-26000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "ext-26m";
	};

	ext_1m: clock-1000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <1000000>;
		clock-output-names = "ext-1m";
	};

	/*
	 * Source: PSCI compatible/method are from research/dumped.dts:3235-3239.
	 */
	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc: soc@0 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * Source: bus shape follows upstream GS101 in gs101.dtsi:529-532.
		 * The 0x40000000 span covers the MMIO addresses used below from the
		 * downstream dump.
		 */
		ranges = <0x0 0x0 0x0 0x40000000>;

		/*
		 * Source: MCT address, clocks, and interrupt map are from
		 * research/dumped.dts:15079-15097.  It is disabled for now because
		 * the architectural timer below is enough for first boot.
		 */
		mct: timer@10050000 {
			compatible = "samsung,exynos4210-mct";
			reg = <0x10050000 0x800>;
			clocks = <&ext_24_5m>, <&ext_24_5m>;
			clock-names = "fin_pll", "mct";
			interrupts = <GIC_SPI 754 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 755 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 756 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 757 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 758 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 759 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 760 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 761 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 762 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 763 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 764 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 765 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};

		/*
		 * Source: GIC address, redistributor size, and PPI partitions are
		 * from research/dumped.dts:15011-15031.
		 */
		gic: interrupt-controller@10400000 {
			compatible = "arm,gic-v3";
			#address-cells = <0>;
			#interrupt-cells = <4>;
			interrupt-controller;
			reg = <0x10400000 0x10000>,
			      <0x10440000 0x200000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;

			ppi-partitions {
				ppi_cluster0: interrupt-partition-0 {
					affinity = <&cpu0 &cpu1 &cpu2 &cpu3 &cpu4 &cpu5 &cpu6>;
				};

				ppi_cluster1: interrupt-partition-1 {
					affinity = <&cpu7>;
				};
			};
		};

		/*
		 * Source: debug UART address, IRQ, FIFO size, and 200 MHz clock source
		 * are from research/dumped.dts:15121-15136.  The compatible and
		 * clock-name spelling use the upstream GS101 UART binding/driver.
		 */
		serial_0: serial@10870000 {
			compatible = "google,gs101-uart";
			reg = <0x10870000 0x100>;
			clocks = <&ext_200m>, <&ext_200m>;
			clock-names = "uart", "clk_uart_baud0";
			interrupts = <GIC_SPI 641 IRQ_TYPE_LEVEL_HIGH 0>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart0_bus>;
			samsung,uart-fifosize = <256>;
			status = "okay";
		};

		/*
		 * Source: pinctrl controller addresses/IRQs are from:
		 *  - peric0: research/dumped.dts:3393-3397
		 *  - peric1: research/dumped.dts:4139-4143
		 *  - hsi0:   research/dumped.dts:4519-4523
		 *  - hsi1:   research/dumped.dts:4628-4632
		 *  - hsi2:   research/dumped.dts:4753-4757
		 *  - eint:   research/dumped.dts:4787-4791
		 *  - alive:  research/dumped.dts:4932-4936
		 *  - far:    research/dumped.dts:5182-5186
		 *  - gsacore blocks: research/dumped.dts:5257-5316
		 *
		 * PERIC0 is enabled first to re-apply the debug UART pins the
		 * bootloader already selected.  The other controllers stay disabled
		 * until their Zumapro bank data and first safe consumers are added.
		 * In particular, do not enable the GSA-owned banks from the
		 * non-secure kernel.
		 */
		pinctrl_peric0: pinctrl@10840000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x10840000 0x1000>;
			interrupts = <GIC_SPI 634 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "okay";

			gpp0: gpp0-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp1: gpp1-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp2: gpp2-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp3: gpp3-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp4: gpp4-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp5: gpp5-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp6: gpp6-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp7: gpp7-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp8: gpp8-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp9: gpp9-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp10: gpp10-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp11: gpp11-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp12: gpp12-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp13: gpp13-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp14: gpp14-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp15: gpp15-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp17: gpp17-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpp16: gpp16-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			/* USI_PERIC0_UART_DBG */
			uart0_bus: uart0-bus-pins {
				samsung,pins = "gpp1-2", "gpp1-3";
				samsung,pin-function = <ZUMAPRO_PIN_FUNC_2>;
				samsung,pin-pud = <ZUMAPRO_PIN_PULL_NONE>;
			};
		};

		pinctrl_peric1: pinctrl@10c40000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x10c40000 0x1000>;
			interrupts = <GIC_SPI 649 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};

		pinctrl_hsi0: pinctrl@12040000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x12040000 0x1000>;
			interrupts = <GIC_SPI 413 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};

		pinctrl_hsi1: pinctrl@13040000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x13040000 0x1000>;
			interrupts = <GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};

		pinctrl_hsi2: pinctrl@13060000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x13060000 0x1000>;
			interrupts = <GIC_SPI 433 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};

		pinctrl_eint: pinctrl@15060000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x15060000 0x1000>;
			interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};

		pinctrl_alive: pinctrl@154d0000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x154d0000 0x1000>;
			interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 32 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 51 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 52 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 53 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 54 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};

		pinctrl_far_alive: pinctrl@154e0000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x154e0000 0x1000>;
			interrupts = <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};

		/*
		 * Source: PMU syscon address is from research/dumped.dts:15242-15246.
		 * Downstream uses "samsung,gs101-pmu", "syscon"; this minimal tree
		 * uses a Zumapro-specific syscon compatible so the watchdog can resolve
		 * its PMU phandle before an upstream Zumapro PMU driver exists.
		 */
		pmu_system_controller: system-controller@15460000 {
			compatible = "google,zumapro-pmu", "syscon";
			reg = <0x15460000 0x10000>;
		};

		pinctrl_gsacore4: pinctrl@16140000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x16140000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore0: pinctrl@16280000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x16280000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore1: pinctrl@16290000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x16290000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore2: pinctrl@162a0000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x162a0000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore3: pinctrl@162b0000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x162b0000 0x1000>;
			status = "disabled";
		};

		/*
		 * Source: watchdog addresses, IRQs, timeout, and PMU phandle are from
		 * research/dumped.dts:15248-15268.  The compatible, clock-name, and
		 * samsung,cluster-index properties follow the upstream samsung-wdt
		 * binding used by GS101; verify PMU bit definitions before relying on
		 * reset behavior.
		 */
		watchdog_cl0: watchdog@10060000 {
			compatible = "google,gs101-wdt";
			reg = <0x10060000 0x100>;
			clocks = <&ext_24_5m>, <&ext_24_5m>;
			clock-names = "watchdog", "watchdog_src";
			interrupts = <GIC_SPI 767 IRQ_TYPE_LEVEL_HIGH 0>;
			samsung,syscon-phandle = <&pmu_system_controller>;
			samsung,cluster-index = <0>;
			timeout-sec = <30>;
			status = "disabled";
		};

		watchdog_cl1: watchdog@10070000 {
			compatible = "google,gs101-wdt";
			reg = <0x10070000 0x100>;
			clocks = <&ext_24_5m>, <&ext_24_5m>;
			clock-names = "watchdog", "watchdog_src";
			interrupts = <GIC_SPI 768 IRQ_TYPE_LEVEL_HIGH 0>;
			samsung,syscon-phandle = <&pmu_system_controller>;
			samsung,cluster-index = <1>;
			timeout-sec = <30>;
			status = "disabled";
		};
	};

	/*
	 * Source: architectural timer interrupts and CNTFRQ are from
	 * research/dumped.dts:15034-15038.
	 */
	timer {
		compatible = "arm,armv8-timer";
		interrupts =
			<GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
			<GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
			<GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
			<GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>;
		clock-frequency = <24576000>;
	};
};
