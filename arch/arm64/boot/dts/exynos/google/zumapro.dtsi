				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			gpa4: gpa4-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			gpa6: gpa6-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 32 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			gpa7: gpa7-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			gpa8: gpa8-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			gpa9: gpa9-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 51 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 52 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 53 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 54 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			gpa10: gpa10-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			gpa11: gpa11-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			gpa12: gpa12-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
			};

			/*
			 * uart18 (APM_USI1 UART) 4-wire bus = Bluetooth HCI.
			 * gpa3-0..3 alt-func 2 from research/dumped.dts uart18_bus
			 * (downstream zumapro-pinctrl.dtsi:1200).
			 */
			uart18_bus: uart18-bus-pins {
				samsung,pins = "gpa3-0", "gpa3-1", "gpa3-2", "gpa3-3";
				samsung,pin-function = <ZUMAPRO_PIN_FUNC_2>;
				samsung,pin-pud = <ZUMAPRO_PIN_PULL_NONE>;
			};

			wakeup-interrupt-controller {
				compatible = "google,zumapro-wakeup-eint",
					     "samsung,exynos850-wakeup-eint",
					     "samsung,exynos7-wakeup-eint";
			};
		};

		pinctrl_far_alive: pinctrl@154e0000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x154e0000 0x1000>;
			status = "okay";

			gpa5: gpa5-gpio-bank {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH 0>;
			};

			wakeup-interrupt-controller {
				compatible = "google,zumapro-wakeup-eint",
					     "samsung,exynos850-wakeup-eint",
					     "samsung,exynos7-wakeup-eint";
			};
		};

		/*
		 * Source: PMU syscon address is from research/dumped.dts:15242-15246.
		 * Downstream uses "samsung,gs101-pmu", "syscon"; this minimal tree
		 * uses a Zumapro-specific syscon compatible so the watchdog can resolve
		 * its PMU phandle before an upstream Zumapro PMU driver exists.
		 */
		pmu_system_controller: system-controller@15460000 {
			compatible = "google,zumapro-pmu", "syscon";
			reg = <0x15460000 0x10000>;
		};

		/*
		 * Source: AP2APM mailbox base and IRQ are from the downstream
		 * ACPM node in research/dumped.dts:15292-15296 (reg 0x15110000,
		 * GIC SPI 80).  The register layout was hardware-verified by
		 * tracing the downstream kernel under the m1n1 hypervisor:
		 * doorbell = 1 << channel to INTGR1 (+0x40), AP-side ack/status
		 * on INTCR0/INTSR0, exactly the gs101 driver's model.  The
		 * mailbox pclk sits in the always-on APM block with no mainline
		 * CMU support; ext_24_5m stands in for it like the watchdog
		 * clocks below.
		 */
		ap2apm_mailbox: mailbox@15110000 {
			compatible = "google,zumapro-mbox", "google,gs101-mbox";
			reg = <0x15110000 0x1000>;
			clocks = <&ext_24_5m>;
			clock-names = "pclk";
			interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <0>;
		};

		pinctrl_gsacore4: pinctrl@16140000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x16140000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore0: pinctrl@16280000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x16280000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore1: pinctrl@16290000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x16290000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore2: pinctrl@162a0000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x162a0000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore3: pinctrl@162b0000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x162b0000 0x1000>;
			status = "disabled";
		};

		/*
		 * Source: watchdog addresses, IRQs, timeout, and PMU phandle are from
		 * research/dumped.dts:15248-15268.  The compatible, clock-name, and
		 * samsung,cluster-index properties follow the upstream samsung-wdt
		 * binding used by GS101; verify PMU bit definitions before relying on
		 * reset behavior.
		 */
		watchdog_cl0: watchdog@10060000 {
			compatible = "google,gs101-wdt";
			reg = <0x10060000 0x100>;
			clocks = <&ext_24_5m>, <&ext_24_5m>;
			clock-names = "watchdog", "watchdog_src";
			interrupts = <GIC_SPI 767 IRQ_TYPE_LEVEL_HIGH 0>;
			samsung,syscon-phandle = <&pmu_system_controller>;
			samsung,cluster-index = <0>;
			timeout-sec = <30>;
			status = "disabled";
		};

		watchdog_cl1: watchdog@10070000 {
			compatible = "google,gs101-wdt";
			reg = <0x10070000 0x100>;
			clocks = <&ext_24_5m>, <&ext_24_5m>;
			clock-names = "watchdog", "watchdog_src";
			interrupts = <GIC_SPI 768 IRQ_TYPE_LEVEL_HIGH 0>;
			samsung,syscon-phandle = <&pmu_system_controller>;
			samsung,cluster-index = <1>;
			timeout-sec = <30>;
			status = "disabled";
		};
	};

	/*
	 * Source: APM SRAM base/size are from the downstream ACPM node in
	 * research/dumped.dts:15296 (0x15700000, 0x58000).  The ACPM channel
	 * table at offset 0xa000 was dumped live over the m1n1 proxy
	 * (scripts/acpm-dump-channels.py, research/tracing/acpm-channels.md).
	 */
	apm_sram: sram@15700000 {
		compatible = "mmio-sram";
		reg = <0x0 0x15700000 0x58000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x15700000 0x58000>;
	};

	/*
	 * Source: architectural timer interrupts and CNTFRQ are from
	 * research/dumped.dts:15034-15038.
	 */
	timer {
		compatible = "arm,armv8-timer";
		interrupts =
			<GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
			<GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
			<GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
			<GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>;
		clock-frequency = <24576000>;
	};
};
