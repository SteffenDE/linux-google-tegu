		};

		pinctrl_gsacore2: pinctrl@162a0000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x162a0000 0x1000>;
			status = "disabled";
		};

		pinctrl_gsacore3: pinctrl@162b0000 {
			compatible = "google,zumapro-pinctrl";
			reg = <0x162b0000 0x1000>;
			status = "disabled";
		};

		/*
		 * Source: watchdog addresses, IRQs, timeout, and PMU phandle are from
		 * research/dumped.dts:15248-15268.  The compatible, clock-name, and
		 * samsung,cluster-index properties follow the upstream samsung-wdt
		 * binding used by GS101; verify PMU bit definitions before relying on
		 * reset behavior.
		 */
		watchdog_cl0: watchdog@10060000 {
			compatible = "google,gs101-wdt";
			reg = <0x10060000 0x100>;
			clocks = <&ext_24_5m>, <&ext_24_5m>;
			clock-names = "watchdog", "watchdog_src";
			interrupts = <GIC_SPI 767 IRQ_TYPE_LEVEL_HIGH 0>;
			samsung,syscon-phandle = <&pmu_system_controller>;
			samsung,cluster-index = <0>;
			timeout-sec = <30>;
			status = "disabled";
		};

		watchdog_cl1: watchdog@10070000 {
			compatible = "google,gs101-wdt";
			reg = <0x10070000 0x100>;
			clocks = <&ext_24_5m>, <&ext_24_5m>;
			clock-names = "watchdog", "watchdog_src";
			interrupts = <GIC_SPI 768 IRQ_TYPE_LEVEL_HIGH 0>;
			samsung,syscon-phandle = <&pmu_system_controller>;
			samsung,cluster-index = <1>;
			timeout-sec = <30>;
			status = "disabled";
		};

		/*
		 * Source: downstream sysmmu@1C110000/@1C150000/@1C190000 in
		 * research/dumped.dts:918-975.  BLK_ISPFE's three Samsung
		 * System MMU v9 instances, all in the same translation context:
		 * a frame buffer's IOVA shows up in every one of their
		 * IOTLB-invalidate registers, so the camera names all three and
		 * lets the v9 driver share one page table between them.
		 *
		 * Three downstream properties are deliberately not carried over.
		 * "sysmmu,async-fault" is parsed there and then never read
		 * again, so it selects nothing.  "sysmmu,ap-read-implies-write"
		 * grants write permission wherever read is granted, which only
		 * changes read-only mappings -- and every mapping the camera
		 * makes is a coherent allocation, already both.  And "s2mpus"
		 * names the stage-2 protection units, which the bootloader
		 * leaves open, as the GPU bring-up established.
		 */
		sysmmu_ispfe_s0: iommu@1c110000 {
			compatible = "samsung,sysmmu-v9";
			reg = <0x1c110000 0x10000>;
			interrupts = <GIC_SPI 488 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 489 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&pd_ispfe>;
			samsung,qos = <15>;
			samsung,secure-irq;
			samsung,secure-base = <0x1c120000>;
			samsung,port-name = "ISPFE S0";
			samsung,pmmu0-default-stream = <0x6030106>;
			samsung,pmmu0-stream-property =
				<0x01 0x106 0x201 0x20 0x78>,
				<0x02 0x1010106 0x201 0x28 0x78>,
				<0x03 0x2020106 0x201 0x30 0x78>,
				<0x04 0x3040106 0x201 0x40 0x78>,
				<0x05 0x4050106 0x201 0x48 0x78>,
				<0x06 0x5060106 0x201 0x50 0x78>,
				<0x07 0x9080106 0x101 0x40 0x60>,
				<0x08 0x8070106 0x101 0x20 0x60>;
			samsung,pmmu1-default-stream = <0x7030106>;
			samsung,pmmu1-stream-property =
				<0x01 0x106 0x201 0x28 0x78>,
				<0x02 0x1010106 0x201 0x30 0x78>,
				<0x03 0x2020106 0x201 0x38 0x78>,
				<0x04 0x3040106 0x201 0x40 0x78>,
				<0x05 0x4050106 0x201 0x48 0x78>,
				<0x06 0x5060106 0x201 0x50 0x78>;
			#iommu-cells = <0>;
			status = "disabled";
		};

		sysmmu_ispfe_s1: iommu@1c150000 {
			compatible = "samsung,sysmmu-v9";
			reg = <0x1c150000 0x10000>;
			interrupts = <GIC_SPI 492 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 493 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&pd_ispfe>;
			samsung,qos = <15>;
			samsung,secure-irq;
			samsung,secure-base = <0x1c160000>;
			samsung,port-name = "ISPFE S1";
			samsung,pmmu0-default-stream = <0x106>;
			#iommu-cells = <0>;
			status = "disabled";
		};

		sysmmu_ispfe_s2: iommu@1c190000 {
			compatible = "samsung,sysmmu-v9";
			reg = <0x1c190000 0x10000>;
			interrupts = <GIC_SPI 496 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 497 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&pd_ispfe>;
			samsung,qos = <15>;
			samsung,secure-irq;
			samsung,secure-base = <0x1c1a0000>;
			samsung,port-name = "ISPFE S2";
			samsung,pmmu0-default-stream = <0x106>;
			samsung,pmmu0-stream-property =
				<0x01 0x106 0x201 0x60 0x60>,
				<0x02 0x106 0x201 0x60 0x60>,
				<0x03 0x3030106 0x201 0x00 0x60>,
				<0x04 0x1010106 0x201 0x20 0x60>,
				<0x05 0x2020106 0x201 0x60 0x60>;
			#iommu-cells = <0>;
			status = "disabled";
		};

		/*
		 * Camera back-end System MMUs.  The bases, fault IRQs, secure
		 * windows and all stream tables are the downstream Zumapro values.
		 * RGBP has two controllers with two and five PMMUs respectively;
		 * YUVP has one.  GDC has three PMMUs and is included because RGBP's
		 * command loader resides in that domain.  They stay disabled with
		 * their power domains until a BE-core consumer can restore every
		 * domain CMU and open every S2MPU before DMA is enabled.
		 */
		sysmmu_gdc: iommu@1d4c0000 {
			compatible = "samsung,sysmmu-v9";
			reg = <0x1d4c0000 0x10000>;
			interrupts = <GIC_SPI 371 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 372 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&pd_gdc>;
			samsung,qos = <15>;
			samsung,secure-irq;
			samsung,secure-base = <0x1d4d0000>;
			samsung,port-name = "GDC";
			samsung,pmmu0-default-stream = <0x15a>;
			samsung,pmmu0-stream-property =
				<0x01 0x15a 0x101 0x04 0x1f>,
				<0x02 0x1404010a 0x101 0x08 0x1f>,
				<0x03 0x1404010a 0x101 0x0c 0x1f>,
				<0x04 0x101015a 0x101 0x10 0x1f>,
				<0x05 0x101015a 0x101 0x14 0x1f>,
				<0x06 0x806011a 0x101 0x18 0x1f>,
				<0x07 0x806011a 0x101 0x1c 0x1f>,
				<0x08 0x402015a 0x201 0x00 0x1f>,
