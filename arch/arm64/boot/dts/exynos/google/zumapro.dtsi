				<0x1d 0xf0e011b 0x101 0x5d 0x7f>;
			#iommu-cells = <0>;
			status = "disabled";
		};

		sysmmu_dpuf1: iommu@19c40000 {
			compatible = "samsung,sysmmu-v9";
			reg = <0x19c40000 0x10000>;
			interrupts = <GIC_SPI 304 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 305 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&pd_dpuf1>;
			samsung,qos = <15>;
			samsung,secure-irq;
			samsung,secure-base = <0x19c50000>;
			samsung,port-name = "DPU F1";
			samsung,pmmu0-default-stream = <0x600014a>;
			samsung,pmmu0-stream-property =
				<0x01 0x600014a 0x101 0x40 0x7f>,
				<0x02 0xa01011b 0x101 0x01 0x7f>,
				<0x03 0xa01011b 0x101 0x41 0x7f>,
				<0x04 0x2015a 0x101 0x08 0x7f>,
				<0x05 0x2015a 0x101 0x48 0x7f>,
				<0x06 0x103015a 0x101 0x0c 0x7f>,
				<0x07 0x103015a 0x101 0x4c 0x7f>,
				<0x08 0xb04011b 0x101 0x09 0x7f>,
				<0x09 0xb04011b 0x101 0x49 0x7f>,
				<0x0a 0xc05010b 0x101 0x0d 0x7f>,
				<0x0b 0xc05010b 0x101 0x4d 0x7f>,
				<0x0c 0x706013a 0x101 0x10 0x7f>,
				<0x0d 0x706010a 0x101 0x50 0x7f>,
				<0x0e 0xd07011b 0x101 0x11 0x7f>,
				<0x0f 0xd07011b 0x101 0x51 0x7f>,
				<0x10 0x208015a 0x101 0x18 0x7f>,
				<0x11 0x208015a 0x101 0x58 0x7f>,
				<0x12 0x309015a 0x101 0x1c 0x7f>,
				<0x13 0x309015a 0x101 0x5c 0x7f>,
				<0x14 0xe0a011b 0x101 0x19 0x7f>,
				<0x15 0xe0a011b 0x101 0x59 0x7f>,
				<0x16 0xf0b010b 0x101 0x1d 0x7f>,
				<0x17 0xf0b010b 0x101 0x5d 0x7f>,
				<0x18 0x140c010b 0x101 0x13 0x7f>,
				<0x19 0x140c010b 0x101 0x53 0x7f>,
				<0x1a 0x150d010b 0x101 0x0b 0x7f>,
				<0x1b 0x150d010b 0x101 0x4b 0x7f>,
				<0x1c 0x160e010b 0x201 0x00 0x7f>,
