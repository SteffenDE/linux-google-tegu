// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 9a "Tegu" device tree skeleton.
 *
 * Hardware values are taken from the downstream dump in
 * ../../../../../../research/dumped.dts unless another source is named.
 */

/dts-v1/;

#include <dt-bindings/input/input.h>

#include "zumapro.dtsi"

/ {
	/*
	 * Source: model and downstream compatible strings are from
	 * research/dumped.dts:6-8.  The lowercase compatible follows the
	 * upstream Google Tensor naming convention in google.yaml.
	 */
	model = "Google Pixel 9a";
	compatible = "google,zumapro-tegu", "google,zumapro";

	aliases {
		/*
		 * Source: downstream debug UART alias is uart0/serial_0 at
		 * research/dumped.dts:5772 and 19824.
		 */
		serial0 = &serial_0;
	};

	chosen {
		/*
		 * Source: downstream bootargs select earlycon/console on
		 * 0x10870000 and ttySAC0 at research/dumped.dts:14938-14943.
		 * The empty bootargs property follows GS101 Pixel common DTS because
		 * Pixel bootloaders expect the property to exist.
		 */
		bootargs = "";
		stdout-path = "serial0:115200n8";

		framebuffer0: framebuffer-0 {
			/*
			 * Experimental bootloader framebuffer handoff. Tegu keeps
			 * the bootloader logo lit into Linux, and GS101 Pixel DTSes
			 * use 0xfac00000 for continuous splash simplefb.
			 */
			compatible = "simple-framebuffer";
			memory-region = <&cont_splash_mem>;
			width = <1080>;
			height = <2424>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
			status = "okay";
		};
	};

	/*
	 * Hardware buttons.  All three are plain alive-bank GPIOs with wakeup
	 * EINTs and no PMIC involvement, so they work with just gpio-keys + the
	 * pin mux below.  Source: research/dumped.dts:15219-15245 (gpio_keys)
	 * and the key-power/key-volup/key-voldown pin nodes there: power on
	 * gpa4-0 (pull-up), volume-down on gpa4-1 and volume-up on gpa6-2 (both
	 * pull-none), all in EINT function.  The downstream Android gpio flag
	 * 0x0f is its own encoding; mainline buttons are active-low (pressed =
	 * grounded), matching the in-tree exynos2200-g0s gpio-keys.
	 */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_power &key_voldown &key_volup>;

		key-power {
			label = "Power";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		key-voldown {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		key-volup {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	decon_trigger_mask: mmio-init@19470030 {
		/*
		 * Stop the bootloader splash before the DPUF System MMUs
		 * enable translation: mask DECON0's HW trigger (TRIG_CON
		 * HW_TRIG_MASK set, HW_TRIG_EN clear) so the orphaned DPP
		 * fetch goes idle within a frame.  Letting it run into the
		 * empty default domain leaves a stalled fault on DPUF0's AXI
		 * port that wedges the interconnect on the next modeset.
		 * This freezes simplefb/fbcon; mainline owns the panel from
		 * the first modeset on.
		 */
		compatible = "linux,mmio-init-helper";
		reg = <0x0 0x19470030 0x4>;
		mask = <0x11>;
		value = <0x10>;
	};

	/*
	 * Source: RAM banks are from research/dumped.dts:20-32 and 14934-14937.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x80000000>;
	};

	memory@880000000 {
		device_type = "memory";
		reg = <0x8 0x80000000 0x80000000>;
	};

	memory@900000000 {
		device_type = "memory";
		reg = <0x9 0x00000000 0x80000000>;
	};

	memory@980000000 {
		device_type = "memory";
		reg = <0x9 0x80000000 0x80000000>;
	};

	reserved-memory {
		/*
		 * Source: static reserved-memory ranges are copied from
		 * research/dumped.dts:1292-1517.  Dynamic size-only DMA pools from
		 * the dump are intentionally omitted for this minimal initramfs tree.
		 */
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Source: ABL fastboot-boot log from 2026-05-24 shows ABL
		 * appends pkvm_guest_firmware@8b000000 before Linux starts.
		 * Keep the downstream range visible here, but do not compile it
		 * while booting through ABL because it overlaps the bootloader
		 * supplied node.
		 */
#if 0
		pkvm_guest_firmware: pkvm-guest-firmware@8b000000 {
			/* Source: research/dumped.dts:1298-1302. */
			reg = <0x0 0x8b000000 0x100000>;
			no-map;
		};
#endif

		ect_reserved: ect@90000000 {
			/* Source: research/dumped.dts:1319-1322. */
			reg = <0x0 0x90000000 0x60000>;
		};

		gsa_reserved: gsa@90200000 {
			/* Source: research/dumped.dts:1325-1328. */
			reg = <0x0 0x90200000 0x3ff000>;
			no-map;
		};

		gsa_reserved_2: gsa@905ff000 {
			/* Source: research/dumped.dts:1331-1334. */
			reg = <0x0 0x905ff000 0x1000>;
			no-map;
		};

		gxp_scratchpad_reserved: gxp-scratchpad@91300000 {
			/* Source: research/dumped.dts:1337-1340. */
			reg = <0x0 0x91300000 0x60000>;
			no-map;
		};

		iif_wait_table_reserved: iif-wait-table@91360000 {
			/* Source: research/dumped.dts:1343-1346. */
			reg = <0x0 0x91360000 0x20000>;
			no-map;
		};

		iif_signal_table_reserved: iif-signal-table@91380000 {
			/* Source: research/dumped.dts:1349-1352. */
			reg = <0x0 0x91380000 0x20000>;
			no-map;
		};

		gxp_secure_data_reserved: gxp-secure-data@91400000 {
			/* Source: research/dumped.dts:1355-1358. */
			reg = <0x0 0x91400000 0x900000>;
			no-map;
		};

		gxp_fw_reserved: gxp-fw@91d00000 {
			/* Source: research/dumped.dts:1361-1364. */
			reg = <0x0 0x91d00000 0x300000>;
			no-map;
		};

		gxp_mcu_fw_reserved: gxp-mcu-fw@92000000 {
			/* Source: research/dumped.dts:1367-1370. */
			reg = <0x0 0x92000000 0x400000>;
			no-map;
		};

		tpu_fw_reserved: tpu-fw@92e00000 {
			/* Source: research/dumped.dts:1373-1376. */
			reg = <0x0 0x92e00000 0x1200000>;
			no-map;
		};

		aoc_reserved: aoc@94000000 {
			/* Source: research/dumped.dts:1379-1382. */
			reg = <0x0 0x94000000 0x3000000>;
			no-map;
		};

		cont_splash_mem: splash@fac00000 {
			/*
			 * Experimental simplefb backing store. 0xfac00000 matches
			 * the GS101 continuous-splash address; no explicit Tegu
			 * downstream reserved-memory node exists in dumped.dts.
			 */
			reg = <0x0 0xfac00000 (1080 * 2424 * 4)>;
			no-map;
		};

		xhci_dma_buffer_reserved: xhci-dma-buffer@17bb5000 {
			/* Source: research/dumped.dts:1508-1512. */
			reg = <0x0 0x17bb5000 0xb000>;
			no-map;
		};

		xhci_dma_reserved: xhci-dma@17bc0000 {
			/* Source: research/dumped.dts:1515-1519. */
			reg = <0x0 0x17bc0000 0x40000>;
			no-map;
		};

		xhci_dma_dram_reserved: xhci-dma-dram@97000000 {
			/* Source: research/dumped.dts:1522-1526. */
			reg = <0x0 0x97000000 0x400000>;
			no-map;
		};

		/*
		 * Source: ABL fastboot-boot log from 2026-05-24 shows ABL
		 * appends sec_dram@b6200000 before Linux starts.  Keep the
		 * downstream range visible here, but do not compile it while
		 * booting through ABL because it overlaps the bootloader supplied
		 * node.
		 */
#if 0
		sec_dram_reserved: sec-dram@b6200000 {
			/* Source: research/dumped.dts:1314-1317. */
			reg = <0x0 0xb6200000 0x9e00000>;
			no-map;
		};
#endif

		seclog_reserved: seclog@c3000000 {
			/* Source: research/dumped.dts:1502-1505. */
			reg = <0x0 0xc3000000 0x80000>;
		};

		header_reserved: header@d8100000 {
			/* Source: research/dumped.dts:1438-1441. */
			reg = <0x0 0xd8100000 0x10000>;
			no-map;
		};

		log_kevents_reserved: log-kevents@d8110000 {
			/* Source: research/dumped.dts:1444-1447. */
			reg = <0x0 0xd8110000 0x700000>;
			no-map;
		};

		log_bcm_reserved: log-bcm@dd610000 {
			/* Source: research/dumped.dts:1450-1454. */
			reg = <0x0 0xdd610000 0x400000>;
			no-map;
		};

		log_s2d_reserved: log-s2d@d8810000 {
			/* Source: research/dumped.dts:1456-1459. */
			reg = <0x0 0xd8810000 0x1800000>;
			no-map;
		};

		log_array_reset_reserved: log-array-reset@da010000 {
			/* Source: research/dumped.dts:1462-1465. */
			reg = <0x0 0xda010000 0xa00000>;
			no-map;
		};

		log_array_panic_reserved: log-array-panic@daa10000 {
			/* Source: research/dumped.dts:1469-1473. */
			reg = <0x0 0xdaa10000 0xa00000>;
			no-map;
		};

		log_slcdump_reserved: log-slcdump@db410000 {
			/* Source: research/dumped.dts:1476-1480. */
			reg = <0x0 0xdb410000 0x1100000>;
			no-map;
		};

		log_preslcdump_reserved: log-preslcdump@dc510000 {
			/* Source: research/dumped.dts:1483-1487. */
			reg = <0x0 0xdc510000 0x1100000>;
			no-map;
		};

		log_itmon_reserved: log-itmon@dda10000 {
			/* Source: research/dumped.dts:1493-1496. */
			reg = <0x0 0xdda10000 0x10000>;
			no-map;
		};

		log_s2d_extract_reserved: log-s2d-extract@dda20000 {
			/* Source: research/dumped.dts:1499-1502. */
			reg = <0x0 0xdda20000 0x600000>;
			no-map;
		};

		/*
		 * Source: ABL fastboot-boot log from 2026-05-24 shows ABL
		 * appends sec_pt@e0000000 before Linux starts.  Keep the
		 * downstream range visible here, but do not compile it while
		 * booting through ABL because it overlaps the bootloader supplied
		 * node.
		 */
#if 0
		sec_pt_reserved: sec-pt@e0000000 {
			/* Source: research/dumped.dts:1309-1312. */
			reg = <0x0 0xe0000000 0x3800000>;
			no-map;
		};
#endif

		cp_rmem_1_reserved: cp-rmem-1@e8000000 {
			/*
			 * Source: research/dumped.dts:1424-1428.  The PKTPROC
			 * DL/UL data rings + buffers; the CP addresses it at
			 * pktproc_cp_base 0x20000000 and self-translates to this
			 * AP-phys before the TLP, so no AP-side window is needed
			 * (research/pktproc-plan.md "Risk #1").  no-map for the
			 * same reason as cp_rmem: the driver maps it non-cached
			 * and the CP DMAs into it (HSI1 IO-coherency is not set
			 * up on mainline).
			 */
			reg = <0x0 0xe8000000 0x2000000>;
			no-map;
		};

		cp_aoc_rmem_reserved: cp-aoc-rmem@197fd000 {
			/* Source: research/dumped.dts:1431-1435. */
			reg = <0x0 0x197fd000 0x3000>;
		};

		cp_rmem_reserved: cp-rmem@ea400000 {
			/*
			 * Source: research/dumped.dts:1410-1414.  no-map so the
			 * modem driver can map it non-cached: the CP reads the
			 * staged boot image and runs the IPC queues in here by
			 * PCIe bus-mastering, and HSI1 IO-coherency is not set
			 * up on mainline.
			 */
			reg = <0x0 0xea400000 0xc00000>;
			no-map;
		};

		cp_msi_rmem_reserved: cp-msi-rmem@f6200000 {
			/*
			 * Source: research/dumped.dts:1417-1421.  no-map for
			 * the same reason: the CP DMA-writes its boot progress
			 * above the MSI termination address in this page.
			 */
			reg = <0x0 0xf6200000 0x1000>;
			no-map;
		};

		abl_reserved: abl@f8800000 {
			/* Source: research/dumped.dts:1304-1307. */
			reg = <0x0 0xf8800000 0x1000000>;
			no-map;
		};

		dss_log_reserved: dss-log@fd3f0000 {
			/* Source: research/dumped.dts:1385-1388. */
			reg = <0x0 0xfd3f0000 0xe000>;
			no-map;
		};

		/*
		 * Source: ABL fastboot-boot log from 2026-05-24 shows ABL
		 * appends debug_kinfo_reserved@fd3fe000 before Linux starts.
		 * Keep the downstream range visible here, but do not compile it
		 * while booting through ABL because it overlaps the bootloader
		 * supplied node.
		 */
#if 0
		debug_kinfo_reserved: debug-kinfo@fd3fe000 {
			/* Source: research/dumped.dts:1391-1394. */
			reg = <0x0 0xfd3fe000 0x1000>;
			no-map;
		};
#endif

		ramoops_reserved: ramoops@fd3ff000 {
			/* Source: research/dumped.dts:1397-1401. */
			compatible = "ramoops";
			reg = <0x0 0xfd3ff000 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		bldr_log_reserved: bldr-log@fd800000 {
			/* Source: research/dumped.dts:1404-1407. */
			reg = <0x0 0xfd800000 0x100000>;
			no-map;
		};
	};
};

&watchdog_cl0 {
	/*
	 * Source: downstream enables watchdog_cl0 implicitly in
	 * research/dumped.dts:15248-15257.  Cluster 1 remains disabled until the
	 * downstream use_multistage_wdt behavior at dumped.dts:15268 is modeled.
	 */
	status = "okay";
};

&pd_dpub {
	status = "okay";
};

&pd_dpuf0 {
	status = "okay";
};

&pd_dpuf1 {
	status = "okay";
};

&cmu_dpub {
	status = "okay";
};

&cmu_dpuf0 {
	status = "okay";
};

&cmu_dpuf1 {
	status = "okay";
};

/*
 * DPU fetch path: framebuffer scanout through DPP0 with the DPUF System MMUs
 * translating.  The always-on display power domains must be enabled so the
 * SysMMU single-domain auto-attach can find its provider.
 *
 * Enabling translation orphans the bootloader splash: its DPP fetch faults
 * against the empty default domain as soon as DECON probes.  The first
 * mainline modeset stops and reprograms the pipeline anyway.
 */
&pd_dpub {
	status = "okay";
};

&pd_dpuf0 {
	status = "okay";
};

&pd_dpuf1 {
	status = "okay";
};

&iommu_group_dpu {
	status = "okay";
};

&sysmmu_dpuf0 {
	status = "okay";
};

&sysmmu_dpuf1 {
	status = "okay";
};

&dpp0 {
	status = "okay";
};

&decon0 {
	status = "okay";
};

/*
 * Transmit-side probe.  Keep this before enabling real scanout: DSIM/DPHY/panel
 * may bind and attach, but link/PHY programming should remain gated on DRM
 * bridge enable or host transfers.
 */
&sysreg_dpub {
	status = "okay";
};

&mipi_phy_dsim0 {
	status = "okay";
};

&dsi0 {
	status = "okay";

	panel@0 {
		status = "okay";
	};
};

/*
 * S2MPG14 main PMIC, reached over ACPM IPC channel 2 with PMIC select 0.
 * Source: downstream zuma-pmic.dtsi s2mpg14mfd (acpm-ipc-channel = <2>,
 * acpm-speedy-channel = <0>, IRQ = INTCOMB_VGPIO2AP_ALIVE = GIC SPI 74).
 * The interrupt is the APM vGPIO combiner output; the mainline driver
 * does not request it yet (no combiner driver), it only has to resolve.
 *
 * Only the touchscreen rails are described, and deliberately WITHOUT
 * voltage constraints: the driver is enable-only, the bootloader leaves
 * the voltage selectors at the correct values (L4M reads 0x3c, L25M 0x2c
 * before the downstream kernel touches them), and the downstream kernel
 * also only ever flips the enable bit (UPDATE val=0x80 mask=0x80) —
 * hardware-verified in research/tracing/acpm-boot-rail-snapshot.md.
 * Downstream constraints, for reference only: L4M 2.5-3.3 V (TS1_AVDD),
 * L25M 1.6-1.95 V (TS1_DVDD).  Keep new rails equally minimal; a wrong
 * voltage constraint here is the one thing that can genuinely damage
 * hardware.
 */
&acpm_ipc {
	pmic {
		compatible = "samsung,s2mpg14-pmic";
		interrupts = <GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH 0>;

		regulators {
			s2mpg14_ldo4: ldo4m {
				regulator-name = "L4M_TS1_AVDD";
			};

			s2mpg14_ldo25: ldo25m {
				regulator-name = "L25M_TS1_DVDD";
			};
		};

		/*
		 * On-device power metering, read-only.  Channel -> rail mux is
		 * the authoritative tegu ODPM assignment from
		 * research/dumped.dts (mux codes are the S2MPG14 muxsel values,
		 * BUCK1..9 = 0x01..0x09).  Channels 0-8 are the internal buck
		 * rails; 9-11 are the external (VSEN) rails (schematic
		 * VSYS_PWR_DISPLAY/CAMERA/RFFE) sensed across an off-chip shunt.
		 */
		meter {
			compatible = "samsung,s2mpg14-meter";
			#address-cells = <1>;
			#size-cells = <0>;

			channel@0 {
				reg = <0>;
				samsung,muxsel = <0x01>;
				label = "VDD_MIF";
			};
			channel@1 {
				reg = <1>;
				samsung,muxsel = <0x02>;
				label = "VDD_CPUCL1_MID";
			};
			channel@2 {
				reg = <2>;
				samsung,muxsel = <0x03>;
				label = "VDD_CPUCL2_BIG";
			};
			channel@3 {
				reg = <3>;
				samsung,muxsel = <0x04>;
				label = "VDD_CPUCL0_LITTLE";
			};
			channel@4 {
				reg = <4>;
				samsung,muxsel = <0x05>;
				label = "VDD_INT";
			};
			channel@5 {
				reg = <5>;
				samsung,muxsel = <0x06>;
				label = "LLDO1";
			};
			channel@6 {
				reg = <6>;
				samsung,muxsel = <0x07>;
				label = "VDD_TPU";
			};
			channel@7 {
				reg = <7>;
				samsung,muxsel = <0x08>;
				label = "LLDO2";
			};
			channel@8 {
				reg = <8>;
				samsung,muxsel = <0x09>;
				label = "VDD_CPUCL1_M";
			};

			/* External (VSEN) rails: VSYS drop across an off-chip shunt. */
			channel@9 {
				reg = <9>;
				samsung,muxsel = <0x5c>;
				shunt-resistor-micro-ohms = <5000>;
				label = "VSYS_PWR_DISPLAY";
			};
			channel@10 {
				reg = <10>;
				samsung,muxsel = <0x5d>;
				shunt-resistor-micro-ohms = <5000>;
				label = "VSYS_PWR_CAMERA";
			};
			channel@11 {
				reg = <11>;
				samsung,muxsel = <0x5e>;
				shunt-resistor-micro-ohms = <5000>;
				label = "VSYS_PWR_RFFE";
			};
		};
	};
};

/*
 * S2MPG15 sub PMIC, reached over ACPM IPC channel 2 with PMIC select 1
 * (mirroring the s2mpg10/s2mpg11 main/sub pair).  Source: downstream
 * zuma-pmic.dtsi s2mpg15mfd (acpm-speedy-channel = <1>).  Only the
 * read-only ODPM power meter is described; no regulators are claimed.
 *
 * Channel -> rail mux follows the tegu ODPM assignment from
 * research/dumped.dts.  Internal rails use the S2MPG15 muxsel values
 * (BUCKnS = 0x0n, LDOnS = 0x20 + n); two external rails (MODEM, WLAN-BT)
 * measure the VSYS drop across an off-chip shunt (muxsel 0x5c-0x5d) and
 * carry the shunt value so the driver can scale them.  Channel 11 is the
 * VSEN_C6/mmWave slot downstream, but the Pixel 9a has no mmWave, so it
 * is mapped to S12S_VDD_AUR (BUCK12S) -- the live rail the downstream
 * kernel meters there on this board.  Labels are the downstream
 * schematic rail names.
 */
&acpm_ipc {
	pmic-sub {
		compatible = "samsung,s2mpg15-pmic";

		/*
		 * The two sensor rails the AoC powers.  Enable-only (bit 7 of
		 * LxS_CTRL); the bootloader leaves the voltage selectors at the
		 * downstream values so no voltage constraint is claimed -- see
		 * s2mps11.c s2mpg15_regulators.  Consumed by the aoc node's
		 * sensor_power_list below.
		 */
		regulators {
			s2mpg15_ldo5: ldo5s {
				regulator-name = "L5S_PROX";
			};

			s2mpg15_ldo7: ldo7s {
				regulator-name = "L7S_SENSORS";
			};
		};

		meter {
			compatible = "samsung,s2mpg15-meter";
			#address-cells = <1>;
			#size-cells = <0>;

			channel@0 {
				reg = <0>;
				samsung,muxsel = <0x01>;
				label = "S1S_VDD_CAM";
			};
			channel@1 {
				reg = <1>;
				samsung,muxsel = <0x02>;
				label = "S2S_VDD_G3D";
			};
			channel@2 {
				reg = <2>;
				samsung,muxsel = <0x04>;
				label = "S4S_VDD2H_MEM";
			};
			channel@3 {
				reg = <3>;
				samsung,muxsel = <0x05>;
				label = "S5S_VDDQ_MEM";
			};
			channel@4 {
				reg = <4>;
				samsung,muxsel = <0x36>;
				label = "L22S_UDFPS";
			};
			channel@5 {
				reg = <5>;
				samsung,muxsel = <0x09>;
				label = "S9S_VDD_AOC";
			};
			channel@6 {
				reg = <6>;
				samsung,muxsel = <0x22>;
				label = "L2S_PLL_MIPI_UFS";
			};
			channel@7 {
				reg = <7>;
				samsung,muxsel = <0x03>;
				label = "S3S_LLDO1";
			};
			channel@8 {
				reg = <8>;
				samsung,muxsel = <0x35>;
				label = "L21S_VDD2L_MEM";
			};
			channel@9 {
				reg = <9>;
				samsung,muxsel = <0x5c>;
				shunt-resistor-micro-ohms = <5000>;
				label = "VSYS_PWR_MODEM";
			};
			channel@10 {
				reg = <10>;
				samsung,muxsel = <0x5d>;
				shunt-resistor-micro-ohms = <10000>;
				label = "VSYS_PWR_WLAN_BT";
			};
			channel@11 {
				reg = <11>;
				samsung,muxsel = <0x0c>;
				label = "S12S_VDD_AUR";
			};
		};
	};
};

/*
 * Give the AoC its sensor rails.  The AoC driver enables sensor_power_list
 * at init (reset_sensor_power); without them the AoC sensor stack has no
 * power and enumerates only fused/software sensors -- the physical
 * LSM6DSV/MMC5616/SPL07003/TMD3733 chips never probe.  sensor_1v8 =
 * L7S_SENSORS (LDO7S, 1.8 V), sensor_3v3 = L5S_PROX (LDO5S, 3.3 V); matches
 * downstream aoc@17000000 in research/dumped.dts.
 */
&aoc {
	sensor_1v8-supply = <&s2mpg15_ldo7>;
	sensor_3v3-supply = <&s2mpg15_ldo5>;
	sensor_power_list = "sensor_1v8", "sensor_3v3";
};

/*
 * Touchscreen: Synaptics TouchComm on BLK_HSI0 USI2 SPI, CS0, 10 MHz.
 * Wiring is from the downstream zuma-tegu-common-touch.dtsi and
 * research/dumped.dts touchscreen@0: IRQ gpn0-0 (active-low, custom-alive
 * EINT bank), reset gpp1-1 (active-low), rails S2MPG14 m_ldo25 (vdd,
 * 1.8 V, L25M_TSP_DVDD) and m_ldo4 (avdd, 3.3 V, L4M_TS_AVDD).
 *
 * The SPI bus pins keep their bootloader mux: downstream ships an empty
 * pinctrl-0 on this bus, so nothing disturbs them (same adoption approach
 * as the display pipeline).  pinctrl_hsi0 is enabled further down for the
 * modem PCIe and speaker-amp pins, but no node touches the SPI bus mux.
 *
 * HW boot 2026-06-12 confirmed the rails are off after ABL (probe ran,
 * SPI transferred, IDENTIFY read all-zero), so they are wired to the
 * real s2mpg14 LDOs above and the driver powers them up itself.
 */
&pinctrl_eint {
	ts_irq: ts-irq-pins {
		samsung,pins = "gpn0-0";
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_NONE>;
		samsung,pin-drv = <ZUMAPRO_PIN_DRV_X1>;
	};
};

&pinctrl_peric0 {
	ts_reset: ts-reset-pins {
		samsung,pins = "gpp1-1";
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_NONE>;
		samsung,pin-drv = <ZUMAPRO_PIN_DRV_X1>;
	};

	/* Left speaker amp reset (downstream tas2572_1_rst). */
	spk_amp_l_rst: spk-amp-l-rst-pins {
		samsung,pins = "gpp6-3";
		samsung,pin-function = <ZUMAPRO_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_NONE>;
	};
};

/*
 * Button pin mux.  Function EINT (0xf) and the pulls match the downstream
 * key-power/key-voldown/key-volup nodes exactly (power pulls up, the volume
 * keys float).  Requesting the wakeup EINT on each gpio-keys gpio drives the
 * interrupt; the static EINT mux here mirrors the in-tree exynos2200-g0s board.
 */
&pinctrl_alive {
	key_power: key-power-pins {
		samsung,pins = "gpa4-0";
		samsung,pin-function = <ZUMAPRO_PIN_FUNC_EINT>;
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_UP>;
		samsung,pin-drv = <ZUMAPRO_PIN_DRV_X1>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa4-1";
		samsung,pin-function = <ZUMAPRO_PIN_FUNC_EINT>;
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_NONE>;
		samsung,pin-drv = <ZUMAPRO_PIN_DRV_X1>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa6-2";
		samsung,pin-function = <ZUMAPRO_PIN_FUNC_EINT>;
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_NONE>;
		samsung,pin-drv = <ZUMAPRO_PIN_DRV_X1>;
	};

	/* Right speaker amp IRQ, XEINT_16 (downstream tas2572_2_irq). */
	spk_amp_r_irq: spk-amp-r-irq-pins {
		samsung,pins = "gpa7-2";
		samsung,pin-function = <ZUMAPRO_PIN_FUNC_EINT>;
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_UP>;
		samsung,pin-drv = <ZUMAPRO_PIN_DRV_X1>;
	};
};

/* Left speaker amp IRQ, XEINT_5 (downstream tas2572_1_irq). */
&pinctrl_far_alive {
	spk_amp_l_irq: spk-amp-l-irq-pins {
		samsung,pins = "gpa5-5";
		samsung,pin-function = <ZUMAPRO_PIN_FUNC_EINT>;
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_UP>;
		samsung,pin-drv = <ZUMAPRO_PIN_DRV_X1>;
	};
};

&usi2_hsi0 {
	status = "okay";
};

&spi_20 {
	status = "okay";

	touchscreen@0 {
		compatible = "syna,tcm-spi";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-cs-setup-delay-ns = <2000>;

		interrupts-extended = <&gpn0 0 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp1 1 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_irq &ts_reset>;

		vdd-supply = <&s2mpg14_ldo25>;
		avdd-supply = <&s2mpg14_ldo4>;

		/*
		 * Opt in to the Touch Bus Negotiator: while the display is off
		 * the driver puts the IC into low-power gesture mode and hands
		 * the SPI bus to AoC (see the /tbn node), so AoC can watch for a
		 * tap and wake the AP over its mailbox.  Without this the driver
		 * uses the plain deep-sleep path and owns the bus throughout.
		 */
		goog,tbn-enabled;
	};
};

/*
 * GPU first light.  The bootloader hands the GPU over powered and the G3D
 * domains are samsung,always-on (see zumapro.dtsi), so panthor adopts the
 * live power state and reads the ACPM idle clocks (core/G3DL2 160 MHz,
 * stacks/G3D 150 MHz).  Requires the CSF firmware staged in the rootfs at
 * /lib/firmware/arm/mali/arch11.8/mali_csffw.bin -- without it panthor
 * probes but bails at firmware load.  The "google,zumapro-mali" compatible
 * makes panthor program the zumapro L2 slice (ASN) hash before L2 power-up;
 * without it the GPU's DRAM accesses (including its own MMU page-table walks)
 * decode to the wrong channel and bus-fault, and the MCU never boots.
 */
&gpu {
	status = "okay";
};

/*
 * MAX77779 ModelGauge m5 fuel gauge on the PMIC I2C bus (USI6/PERIC0).  The
 * gauge tracks state-of-charge autonomously and this driver only reads it, so
 * no battery model is programmed and no rail is touched.  The interrupt lives
 * on the MAX77779 PMIC core (not yet supported), so the driver polls; the node
 * therefore carries no interrupt.  The 2 mOhm sense resistor matches the
 * downstream default (max77779,rsense-default of 200 in 10-uOhm units) and the
 * tegu battery model files (BC79_TG4_2mOhm_*), and scales the current and
 * charge readings.
 */
&hsi2c_6 {
	fuel-gauge@36 {
		compatible = "maxim,max77779fg";
		reg = <0x36>;
		shunt-resistor-micro-ohms = <2000>;
	};
};

&usi4_hsi0 {
	status = "okay";
};

/*
 * Speaker amplifiers: two TI TAS2572 dies, one per speaker.  Downstream
 * models them as a single ti,tas25xx node fronting both I2C addresses
 * (research/dumped.dts:6833, zumapro-tegu-audio-common-tas2572.dtsi); the
 * mainline tas2781 driver supports the TAS2572 in register mode with no
 * DSP firmware, but takes one reset/IRQ line per node, so each die gets
 * its own node.  Reset and IRQ GPIOs are from the dumped ti,reset-gpio(2)/
 * ti,irq-gpio(2) properties.  The amps are wired to the AoC TDM0 backend;
 * they only make sound once the AoC sound card exists, but they probe and
 * expose regmap/controls standalone.
 */
&hsi2c_19 {
	status = "okay";
	clock-frequency = <400000>;

	speaker_amp_l: amplifier@48 {
		compatible = "ti,tas2572";
		reg = <0x48>;
		#sound-dai-cells = <0>;
		reset-gpios = <&gpp6 3 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpa5 5 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&spk_amp_l_irq &spk_amp_l_rst>;
		sound-name-prefix = "L";
	};

	speaker_amp_r: amplifier@49 {
		compatible = "ti,tas2572";
		reg = <0x49>;
		#sound-dai-cells = <0>;
		reset-gpios = <&gph2 1 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpa7 2 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&spk_amp_r_irq &spk_amp_r_rst>;
		sound-name-prefix = "R";
	};
};

/*
 * PCIe GEN3A_1 root complex for the on-board Broadcom BCM4383 WiFi.
 *
 * Pin wiring is from research/dumped.dts:4714-4750: PERST# on gph3-0
 * (active low, driven by the controller), CLKREQ# on gph3-1 (special
 * function 2, pull-up), and WL_REG_ON on gph3-4.  The WiFi chip is the
 * PCIe link partner, so it must be powered for the link to train; until a
 * WiFi driver owns WL_REG_ON, a GPIO hog holds it asserted from boot so
 * the endpoint enumerates.
 */
/*
 * gph3/gph4 live on the HSI2 GPIO pin controller (pinctrl_hsi1, 0x13040000),
 * which the minimal tree leaves disabled.  Enable it so the PCIe PERST#,
 * CLKREQ# and WL_REG_ON lines on gph3 are usable.
 */
&pinctrl_hsi1 {
	status = "okay";

	pcie1_clkreq: pcie1-clkreq-pins {
		samsung,pins = "gph3-1";
		samsung,pin-function = <ZUMAPRO_PIN_FUNC_2>;
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_UP>;
		samsung,pin-drv = <ZUMAPRO_PIN_DRV_X3>;
	};
};

&gph3 {
	wlan_reg_on_hog: wlan-reg-on-hog {
		gpio-hog;
		gpios = <4 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "wlan-reg-on";
	};
};

/*
 * PCIe CH0 (HSI1): the Exynos Modem 5300.  PERST# is gph0-0 and CLKREQ# is
 * gph0-1 (special function 2, pull-up) on the HSI1 GPIO pin controller at
 * 0x12040000 (labelled pinctrl_hsi0 in this tree), from
 * research/dumped.dts:4549-4565.  The CP rail-sequencing lines below are from
 * the downstream cpif node (research/dumped.dts:20622-20632); they carry raw
 * levels, so all are GPIO_ACTIVE_HIGH and the RC's bring-up stub writes the
 * downstream values verbatim.
 *
 * The link is capped at Gen1 x1 for bring-up: downstream also trains the
 * first boot-time link at GEN1 x1 (s5100_poweron_pcie(boot_on)) and only
 * moves to Gen3 x2 with the link bounce after the boot-image download, which
 * needs the modem driver.
 */
&pinctrl_hsi0 {
	status = "okay";

	pcie0_clkreq: pcie0-clkreq-pins {
		samsung,pins = "gph0-1";
		samsung,pin-function = <ZUMAPRO_PIN_FUNC_2>;
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_UP>;
		samsung,pin-drv = <ZUMAPRO_PIN_DRV_X3>;
	};

	/* Right speaker amp reset (downstream tas2572_2_rst). */
	spk_amp_r_rst: spk-amp-r-rst-pins {
		samsung,pins = "gph2-1";
		samsung,pin-function = <ZUMAPRO_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <ZUMAPRO_PIN_PULL_NONE>;
	};
};

&pcie0_phy {
	status = "okay";
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_clkreq>;
	reset-gpios = <&gph0 0 GPIO_ACTIVE_LOW>;
	num-lanes = <1>;
	max-link-speed = <1>;
	google,cp-pwr-gpios = <&gpp12 2 GPIO_ACTIVE_HIGH>;
	google,cp-nreset-gpios = <&gpp12 3 GPIO_ACTIVE_HIGH>;
	google,cp-pm-wrst-gpios = <&gpp8 3 GPIO_ACTIVE_HIGH>;
	google,cp-wrst-gpios = <&gpp16 3 GPIO_ACTIVE_HIGH>;
	google,cp-wakeup-gpios = <&gpp16 0 GPIO_ACTIVE_HIGH>;
	google,cp-pda-active-gpios = <&gpp16 2 GPIO_ACTIVE_HIGH>;
	/*
	 * Source: dumped.dts gpio_ap2cp_dump_noti (gpp16-1).  Downstream
	 * power_on_cp() drives it low before the rails; left floating, CP MAIN
	 * may boot into dump mode instead of normal IPC.
	 */
	google,cp-dump-noti-gpios = <&gpp16 1 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

/*
 * Exynos Modem 5300 boot control.  Consumes the endpoint the CH0 RC
 * enumerates: stages the first-stage CP bootloader in cp_rmem, points the
 * RC's MSI target at cp_msi_rmem (the mask ROM reports boot progress above
 * that address) and runs the shared-memory handshake to CP ONLINE.  The
 * doorbell bus address and the CP2AP_WAKEUP line (gpa5-1) are from the
 * downstream cpif node (research/dumped.dts:20516, 20632).
 */
/ {
	/*
	 * Touch Bus Negotiator.  tbn,mode = 2 (TBN_MODE_AOC_CHANNEL): the
	 * AP <-> AoC bus handshake runs as messages over the com.google.tbn
	 * AoC service, not over GPIOs.  Matches research/dumped.dts, which
	 * carries a bare /tbn node with tbn,mode = 2 and no GPIOs.
	 * tbn,max_devices defaults to 1 (single touch consumer).
	 */
	tbn {
		compatible = "touch_bus_negotiator";
		tbn,mode = <2>;
		tbn,max_devices = <1>;
	};

	modem {
		compatible = "samsung,s5300-modem";
		memory-region = <&cp_rmem_reserved>, <&cp_msi_rmem_reserved>,
				<&cp_rmem_1_reserved>;
		memory-region-names = "ipc", "msi", "pktproc";
		firmware-name = "tegu/cp_pbl.bin";
		google,pcie = <&pcie0>;
		samsung,doorbell-addr = <0x14e60000>;
		cp2ap-wakeup-gpios = <&gpa5 1 GPIO_ACTIVE_HIGH>;
		/*
		 * Optional CP-aliveness inputs, read only to classify a runtime
		 * link wedge: CP_ACTIVE (gpa5-2) is the CP firmware heartbeat
		 * (low = crash), PS_HOLD (gpa5-0) is the CP power-rail hold
		 * (low = the CP powered its own rail off).  gpa5-{0,2} from the
		 * downstream cpif node (gpio_cp2ap_cp_ps_hold,
		 * gpio_cp2ap_phone_active).
		 */
		cp2ap-active-gpios = <&gpa5 2 GPIO_ACTIVE_HIGH>;
		cp2ap-ps-hold-gpios = <&gpa5 0 GPIO_ACTIVE_HIGH>;
	};
};

&pcie_phy {
	status = "okay";
};

&pcie {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_clkreq>;
	reset-gpios = <&gph3 0 GPIO_ACTIVE_LOW>;
	status = "okay";

	/*
	 * Describe the on-board BCM4383 endpoint (bus 1, device 0) behind the
	 * root port (bus 0, device 0) so brcmfmac gets an of_node and runs its
	 * MAC-address path.  The per-device WLAN MAC is not in the chip; the
	 * bootloader publishes it in /chosen/config/wlan_mac1, which brcmfmac
	 * reads as a fallback (see brcmfmac of.c).
	 */
	pci@0,0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0x01 0x01>;
		ranges;

		wifi@0,0 {
			compatible = "pci14e4,4449", "brcm,bcm4329-fmac";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
		};
	};
};
