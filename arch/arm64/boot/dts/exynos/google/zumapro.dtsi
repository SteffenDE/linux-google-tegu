					     <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH 0>,
