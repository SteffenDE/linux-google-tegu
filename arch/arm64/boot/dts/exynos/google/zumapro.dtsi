		};

		/*
		 * Camera back-end processing core.  Source: downstream
		 * lwis_be_core@1C440000 in research/dumped.dts:13101.  The three
		 * processor windows, seven SSMT windows and RGBP routing register
		 * preserve the downstream resource order.  CMDQ shares each block's
		 * INT0 GIC line, so the downstream nine interrupt entries reduce to
		 * the six unique physical lines below.
		 *
		 * RGBP's command loader resides in BLK_GDC.  Consequently all three
		 * domains and GDC's System MMU are dependencies even though the first
		 * offline path only submits RGBP and YUVP programs.  Keep the complete
		 * complex passive until the board opts into the lifecycle driver.
		 */
		becore: camera@1c440000 {
			compatible = "google,zumapro-becore";
			reg = <0x1c440000 0x10000>,
			      <0x1c470000 0x10000>,
			      <0x1c840000 0x10000>,
			      <0x1c5d4000 0xe00>,
			      <0x1c914000 0xe00>,
			      <0x1c420404 0x4>,
			      <0x1c604000 0xe00>,
			      <0x1c614000 0xe00>,
			      <0x1c624000 0xe00>,
			      <0x1c634000 0xe00>,
			      <0x1c644000 0xe00>;
			reg-names = "rgbp", "mcfp", "yuvp", "ssmt-rgbp",
				    "ssmt-yuvp", "sysreg-rgbp", "ssmt-mcfp0",
				    "ssmt-mcfp1", "ssmt-mcfp2", "ssmt-mcfp3",
				    "ssmt-mcfp4";
			interrupts = <GIC_SPI 673 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 674 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 663 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 664 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 744 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 745 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "rgbp-int0", "rgbp-int1",
					  "mcfp-int0", "mcfp-int1",
					  "yuvp-int0", "yuvp-int1";
			power-domains = <&pd_yuvp>, <&pd_rgbp>, <&pd_gdc>;
			power-domain-names = "yuvp", "rgbp", "gdc";
			iommus = <&sysmmu_yuvp>, <&sysmmu_rgbp_s0>,
				 <&sysmmu_rgbp_s1>, <&sysmmu_gdc>;
			samsung,iommu-group = <&iommu_group_isp>;
			status = "disabled";
		};

		/*
		 * BLK_ISPFE, the camera receive complex: twelve CSIS links with
		 * nine combo D/C-PHYs behind them, the ISPFE front end, and the
		 * PDMA that carries per-frame descriptors.  Windows are the
		 * reg/reg-names of downstream's lwis_isp_fe@1C000000
		 * (research/dumped.dts:13000-13005).
		 *
		 * Two of those windows nest inside the first: "pdma" and
		 * "pdma-wrap" fall within the 1 MB "isp-fe" range, and downstream
		 * maps them separately because they are separately named blocks.
		 * Keep that split -- a PDMA register is reachable either way, and
		 * treating the whole 1 MB as one opaque window is what made PDMA
		 * traffic look like it did not exist.
		 *
		 * The PMU phandle carries the offset of the word that isolates
		 * the nine D/C-PHYs, which every downstream dcphy node names as
		 * "isolation = <0x3ebc>".  It is a second gate entirely separate
		 * from the per-PHY reset in isp-fe-sysreg, and while it is set
		 * the whole PHY register region reads zero and takes no writes.
		 *
		 * The three "s2mpu" windows are the stage-2 protection units in
		 * front of this block's System MMUs.  They are here rather than
		 * as their own nodes because nothing drives them: they reset
		 * with the power domain into a state that blocks all DMA, and
		 * the vendor's own driver reopens them from its resume path
		 * whenever the hypervisor that would otherwise own them is
		 * absent -- which on mainline is always.  The bootloader
		 * leaving them open, as the GPU bring-up found, only holds
		 * until something power-cycles the domain, and this driver does.
		 *
		 * The "cmu" window is a bring-up shortcut and should not outlive
		 * it.  CMU_ISPFE loses its mux, dividers and Q-channel requests
		 * across a power cycle and mainline models no clock controller for
		 * it, so the driver restores them itself; the right home is a
		 * clock-controller node once CMU_ISPFE is described.  It overlaps
		 * the 4-byte "cmu" window in pd_ispfe, which is fine because both
		 * sides use devm_ioremap() rather than an exclusive request.
		 *
		 * Downstream names 202 interrupts on this block; they land on 17
		 * GIC lines, and all 17 are here.  Each "csis<n>" is one CSIS
		 * link bank's four sources -- int0, int1, frame start and frame
		 * end -- sharing SPI 467 + n.  "csis-core" carries 120 named
		 * sources for the CSIS core and its logical channels.  "fc" is
		 * every frame-controller context, bayer and phase-detect alike;
		 * "lmp-bayer" is the five bayer line-memory instances plus a
		 * debug source, "lmp-pdaf" the four phase-detect ones, and
		 * "pdma" all five PDMA contexts with their error and reset
		 * sources.
		 *
		 * Which link a sensor arrives on is a board property, so the SoC
		 * file names all twelve and the driver asks for the one it is
		 * configured to use.  The same reasoning names the phase-detect
		 * line-memory pool even though a raw Bayer path does not use it:
		 * this describes the block, not one driver's needs.
		 */
		ispfe: camera@1c300000 {
			compatible = "google,zumapro-ispfe";
			reg = <0x1c300000 0x100000>,
			      <0x1c040000 0xd0000>,
			      <0x1c020000 0x10000>,
			      <0x1c390000 0x5000>,
			      <0x1c395000 0x1000>,
			      <0x1c000000 0x8000>,
			      <0x1c140000 0x10000>,
			      <0x1c180000 0x10000>,
			      <0x1c1c0000 0x10000>;
			reg-names = "isp-fe", "csis-link-phy", "isp-fe-sysreg",
				    "pdma", "pdma-wrap", "cmu",
				    "s2mpu0", "s2mpu1", "s2mpu2";
			interrupts = <GIC_SPI 467 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 468 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 469 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 470 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 471 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 472 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 473 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 474 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 475 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 476 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 477 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 478 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 479 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 480 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 481 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 482 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 483 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "csis0", "csis1", "csis2", "csis3",
					  "csis4", "csis5", "csis6", "csis7",
					  "csis8", "csis9", "csis10", "csis11",
					  "csis-core", "fc", "lmp-bayer",
					  "lmp-pdaf", "pdma";
			power-domains = <&pd_ispfe>;
			clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CAM>;
			clock-names = "cam";
			interconnects = <&bts ZUMAPRO_BTS_MASTER_ISPFE>,
					<&bts ZUMAPRO_BTS_SLAVE_MIF>;
			interconnect-names = "memory";
			google,backend = <&becore>;
			iommus = <&sysmmu_ispfe_s0>, <&sysmmu_ispfe_s1>,
				 <&sysmmu_ispfe_s2>;
			samsung,iommu-group = <&iommu_group_isp>;
			samsung,pmu-syscon = <&pmu_system_controller 0x3ebc>;
			status = "disabled";
		};
	};

	/*
	 * Source: APM SRAM base/size are from the downstream ACPM node in
	 * research/dumped.dts:15296 (0x15700000, 0x58000).  The ACPM channel
	 * table at offset 0xa000 was dumped live over the m1n1 proxy
	 * (scripts/acpm-dump-channels.py, research/tracing/acpm-channels.md).
	 */
	apm_sram: sram@15700000 {
		compatible = "mmio-sram";
		reg = <0x0 0x15700000 0x58000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x15700000 0x58000>;
	};

	/*
	 * Source: architectural timer interrupts and CNTFRQ are from
	 * research/dumped.dts:15034-15038.
	 */
	timer {
		compatible = "arm,armv8-timer";
		interrupts =
			<GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
			<GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
			<GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
			<GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>;
		clock-frequency = <24576000>;
	};
};
